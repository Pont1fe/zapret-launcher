<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret Launcher" Width="1000" Height="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="76"/>
      <ColumnDefinition Width="420"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- Заголовок окна -->
    <Grid Grid.ColumnSpan="3" Background="{DynamicResource TitleBg}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <Image x:Name="TitleIcon" Width="18" Height="18" VerticalAlignment="Center"/>
        <TextBlock Text="Zapret Launcher" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="TitleText" Text="" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnMinimize" Style="{DynamicResource ChromeButton}" Content="&#xE921;"/>
        <Button x:Name="BtnClose" Style="{DynamicResource ChromeButton}" Content="&#xE8BB;"/>
      </StackPanel>
    </Grid>

    <!-- Боковое меню -->
    <Grid Grid.Row="1" Background="{DynamicResource SidebarBg}">
      <StackPanel HorizontalAlignment="Center" Margin="0,8,0,0">
        <RadioButton x:Name="NavStrategies" Style="{DynamicResource NavButton}" Content="&#xE774;" Tag="Обход" IsChecked="True"/>
        <RadioButton x:Name="NavDomains" Style="{DynamicResource NavButton}" Content="&#xE71B;" Tag="Домены"/>
        <RadioButton x:Name="NavSettings" Style="{DynamicResource NavButton}" Content="&#xE713;" Tag="Настройки"/>
        <RadioButton x:Name="NavLog" Style="{DynamicResource NavButton}" Content="&#xE8A5;" Tag="Журнал"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12">
        <Button x:Name="NavFolder" Style="{DynamicResource IconButton}" Width="44" Height="40" FontSize="16" Content="&#xE8B7;" ToolTip="Папка zapret"/>
        <Button x:Name="NavInfo" Style="{DynamicResource IconButton}" Width="44" Height="40" FontSize="16" Content="&#xE946;" ToolTip="Страница лаунчера на GitHub"/>
      </StackPanel>
    </Grid>

    <!-- Средняя панель -->
    <Grid x:Name="MidPanel" Grid.Row="1" Grid.Column="1" Background="{DynamicResource MidBg}">

      <!-- Стратегии -->
      <Grid x:Name="PageStrategies" Margin="22,20,16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,6,0">
          <TextBlock Text="Стратегии" Style="{DynamicResource PageTitle}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="BtnInstallUpdate" Style="{DynamicResource IconButton}" Content="&#xE896;" Foreground="{DynamicResource AccentHover}"
                    ToolTip="Установить обновление zapret" Visibility="Collapsed"/>
            <Button x:Name="BtnCheck" Style="{DynamicResource IconButton}" Content="&#xE72C;" ToolTip="Проверить обновления"/>
            <Button x:Name="BtnFolder2" Style="{DynamicResource IconButton}" Content="&#xE8B7;" ToolTip="Папка zapret"/>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
          <Border CornerRadius="6" Background="{DynamicResource Card}" Padding="8,2" VerticalAlignment="Center">
            <TextBlock x:Name="VersionPill" Text="" FontSize="11"/>
          </Border>
          <TextBlock x:Name="LatestText" Text="" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="CardSubtitle" Text="" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,14,6,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border CornerRadius="10" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="38">
            <Grid Margin="12,0">
              <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Icons}" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock x:Name="SearchHint" Text="Поиск стратегии" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
              <TextBox x:Name="SearchBox" Style="{DynamicResource InputBox}" Margin="22,0,0,0"/>
            </Grid>
          </Border>
          <Button x:Name="BtnPing" Grid.Column="1" Style="{DynamicResource GhostButton}" Height="38" Margin="8,0,0,0" ToolTip="Заново проверить сайты и пинг">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="Обновить пинг" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>

        <ListBox x:Name="StrategyList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{DynamicResource StrategyItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{DynamicResource Caption}" Margin="4,10,0,6"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="{Binding Color}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Ellipse Width="6" Height="6" Fill="{Binding MarkColor}" Visibility="{Binding MarkVisibility}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Style="{DynamicResource IconButton}" Width="30" Height="30" FontSize="14"
                        Content="{Binding StarGlyph}" Foreground="{Binding StarColor}" Tag="{Binding File}" ToolTip="{Binding StarTip}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Домены -->
      <Grid x:Name="PageDomains" Visibility="Collapsed" Margin="22,20,22,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Домены" Style="{DynamicResource PageTitle}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
          <RadioButton x:Name="DomGeneral" Style="{DynamicResource Segment}" GroupName="dom" Content="Обходить" IsChecked="True"/>
          <RadioButton x:Name="DomExclude" Style="{DynamicResource Segment}" GroupName="dom" Content="Не трогать"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border CornerRadius="10" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Background="{DynamicResource Input}" Height="38">
            <Grid Margin="12,0">
              <TextBlock x:Name="DomainHint" Text="Например: example.com" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBox x:Name="DomainInput" Style="{DynamicResource InputBox}" Margin="-2,0,0,0"/>
            </Grid>
          </Border>
          <Button x:Name="BtnAddDomain" Grid.Column="1" Style="{DynamicResource AccentButton}" Height="38" Margin="8,0,0,0" Content="Добавить"/>
        </Grid>
        <TextBlock x:Name="DomainInfo" Grid.Row="3" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,8,0,12" TextWrapping="Wrap"
                   Text="Поддомены учитываются автоматически. Изменения применяются сразу."/>
        <Grid Grid.Row="4">
          <StackPanel x:Name="DomainEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource Icons}" FontSize="34" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DomainEmptyText" Text="Список пуст" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Margin="0,12,0,0"/>
          </StackPanel>
          <ListBox x:Name="DomainList" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{DynamicResource PlainItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Style="{DynamicResource IconButton}" Width="28" Height="28" FontSize="11"
                          Content="&#xE711;" Tag="{Binding}" ToolTip="Удалить"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>

      <!-- Настройки -->
      <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,18,16">
          <TextBlock Text="Настройки" Style="{DynamicResource PageTitle}"/>

          <TextBlock Text="ОФОРМЛЕНИЕ" Style="{DynamicResource SectionLabel}"/>
          <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel>
                  <TextBlock Text="Тема" Style="{DynamicResource RowTitle}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="ThemeDark" Style="{DynamicResource Segment}" GroupName="theme" Content="Тёмная"/>
                    <RadioButton x:Name="ThemeLight" Style="{DynamicResource Segment}" GroupName="theme" Content="Светлая"/>
                    <RadioButton x:Name="ThemeSystem" Style="{DynamicResource Segment}" GroupName="theme" Content="Как в Windows"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <CheckBox x:Name="SwMica" Style="{DynamicResource Switch}">
                <StackPanel>
                  <TextBlock Text="Прозрачный фон (Mica)" Style="{DynamicResource RowTitle}"/>
                  <TextBlock x:Name="MicaSub" Text="Как у приложений Windows 11: сквозь окно слегка видно цвет обоев" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel>
                  <TextBlock Text="Язык интерфейса" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Лаунчер перезапустится, обход продолжит работать" Style="{DynamicResource RowSub}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="LangRu" Style="{DynamicResource Segment}" GroupName="lang" Content="Русский"/>
                    <RadioButton x:Name="LangEn" Style="{DynamicResource Segment}" GroupName="lang" Content="English"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Button x:Name="BtnOnboarding" Style="{DynamicResource RowButton}">
                <StackPanel>
                  <TextBlock Text="Показать приветствие" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Короткое знакомство с лаунчером из трёх шагов" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <TextBlock Text="ЗАПУСК И ОБНОВЛЕНИЯ" Style="{DynamicResource SectionLabel}"/>
          <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
              <CheckBox x:Name="SwAutostart" Style="{DynamicResource Switch}">
                <StackPanel>
                  <TextBlock Text="Запускать вместе с Windows" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Обход включится сам, лаунчер — в трее" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="SwWatchdog" Style="{DynamicResource Switch}">
                <StackPanel>
                  <TextBlock Text="Сторож" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Перезапускает упавший обход и сам меняет стратегию, если сайты перестали открываться" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="SwVpnPause" Style="{DynamicResource Switch}">
                <StackPanel>
                  <TextBlock Text="Пауза, пока включён VPN" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="С VPN zapret не нужен: обход выключится сам и вернётся, когда VPN отключат" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="SwAutoUpdate" Style="{DynamicResource Switch}">
                <StackPanel>
                  <TextBlock Text="Обновлять автоматически" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="zapret, tg-ws-proxy и лаунчер — при запуске и каждые 6 часов" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="SwStartOnOpen" Style="{DynamicResource Switch}">
                <StackPanel>
                  <TextBlock Text="Включать обход при открытии лаунчера" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Используется последняя выбранная стратегия" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="SwToasts" Style="{DynamicResource Switch}">
                <StackPanel>
                  <TextBlock Text="Уведомления Windows" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="О паузе при VPN, смене стратегии и обновлениях — с кнопками действий" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <TextBlock Text="СЕТИ" Style="{DynamicResource SectionLabel}"/>
          <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
              <CheckBox x:Name="SwNetProfiles" Style="{DynamicResource Switch}">
                <StackPanel>
                  <TextBlock Text="Своя стратегия для каждой сети" Style="{DynamicResource RowTitle}"/>
                  <TextBlock x:Name="NetCurrentText" Text="" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
              <StackPanel x:Name="NetListPanel"/>
            </StackPanel>
          </Border>

          <TextBlock Text="ФИЛЬТРЫ" Style="{DynamicResource SectionLabel}"/>
          <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel>
                  <TextBlock Text="Game Filter" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Обход для игр и программ на портах выше 1023" Style="{DynamicResource RowSub}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="GfOff" Style="{DynamicResource Segment}" GroupName="gf" Content="Выкл"/>
                    <RadioButton x:Name="GfTcp" Style="{DynamicResource Segment}" GroupName="gf" Content="TCP"/>
                    <RadioButton x:Name="GfUdp" Style="{DynamicResource Segment}" GroupName="gf" Content="UDP"/>
                    <RadioButton x:Name="GfAll" Style="{DynamicResource Segment}" GroupName="gf" Content="TCP + UDP"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Padding="16,12">
                <StackPanel>
                  <Grid>
                    <StackPanel>
                      <TextBlock Text="IPSet" Style="{DynamicResource RowTitle}"/>
                      <TextBlock Text="Обход по IP-адресам. «Все IP» может сломать часть сайтов" Style="{DynamicResource RowSub}"/>
                    </StackPanel>
                    <Button x:Name="BtnIpsetUpdate" Style="{DynamicResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Обновить список IP-адресов"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="IpNone" Style="{DynamicResource Segment}" GroupName="ip" Content="Выкл"/>
                    <RadioButton x:Name="IpLoaded" Style="{DynamicResource Segment}" GroupName="ip" Content="По списку"/>
                    <RadioButton x:Name="IpAny" Style="{DynamicResource Segment}" GroupName="ip" Content="Все IP"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Text="TELEGRAM" Style="{DynamicResource SectionLabel}"/>
          <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
              <CheckBox x:Name="SwTelegram" Style="{DynamicResource Switch}">
                <StackPanel>
                  <TextBlock Text="Telegram Desktop и Web вместе с обходом" Style="{DynamicResource RowTitle}"/>
                  <TextBlock x:Name="TgSub" Text="Desktop — прокси tg-ws-proxy, Web — через hosts" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
              <Button x:Name="BtnTgConnect" Style="{DynamicResource RowButton}">
                <StackPanel>
                  <TextBlock Text="Подключить Telegram Desktop" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Откроет Telegram — нажмите «Подключиться» в окне прокси" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <TextBlock Text="ИНСТРУМЕНТЫ" Style="{DynamicResource SectionLabel}"/>
          <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
              <Button x:Name="BtnService" Style="{DynamicResource RowButton}">
                <StackPanel>
                  <TextBlock Text="service.bat" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Ручные тесты и диагностика zapret в консоли" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnRollback" Style="{DynamicResource RowButton}" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="RollbackTitle" Text="Откатить zapret" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Если новая версия работает хуже — вернуть прошлую" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnRemoveService" Style="{DynamicResource RowButton}" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="Удалить службу zapret" Style="{DynamicResource RowTitle}" Foreground="{DynamicResource Danger}"/>
                  <TextBlock Text="Служба из service.bat мешает управлять обходом" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <TextBlock Text="ЛАУНЧЕР" Style="{DynamicResource SectionLabel}"/>
          <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
              <Button x:Name="BtnLauncherUpdate" Style="{DynamicResource RowButton}">
                <StackPanel>
                  <TextBlock x:Name="LauncherVersionText" Text="Zapret Launcher" Style="{DynamicResource RowTitle}"/>
                  <TextBlock x:Name="LauncherRepoText" Text="" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnUninstall" Style="{DynamicResource RowButton}">
                <StackPanel>
                  <TextBlock Text="Удалить всё" Style="{DynamicResource RowTitle}" Foreground="{DynamicResource Danger}"/>
                  <TextBlock Text="Остановить обход, убрать автозапуск, драйвер, записи в hosts и ярлыки" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Журнал -->
      <Grid x:Name="PageLog" Visibility="Collapsed" Margin="22,20,22,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Журнал" Style="{DynamicResource PageTitle}" Margin="0,0,0,14"/>
        <Border Grid.Row="1" CornerRadius="14" Background="{DynamicResource Card}" Padding="12">
          <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSub}"
                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Border>
      </Grid>
    </Grid>

    <!-- Правая панель: статус -->
    <Grid Grid.Row="1" Grid.Column="2" ClipToBounds="True" Background="{DynamicResource RightBg}">
      <Ellipse x:Name="GlowBg" Width="560" Height="420" VerticalAlignment="Top" Margin="0,-170,0,0" Opacity="0" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="{DynamicResource GlowColor}" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <DockPanel Margin="24,20,24,20" LastChildFill="False">
        <Grid DockPanel.Dock="Top">
          <TextBlock Text="СТАТУС ОБХОДА" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
          <Border HorizontalAlignment="Right" CornerRadius="12" Background="{DynamicResource Card}" Padding="10,4" MaxWidth="300">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="NetIcon" Text="&#xE839;" FontFamily="{DynamicResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock x:Name="NetStatus" Text=" " FontSize="11" Foreground="{DynamicResource TextSub}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="ConflictBar" DockPanel.Dock="Top" Margin="0,14,0,0" CornerRadius="10" Background="{DynamicResource WarnBg}"
                BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1" Padding="12,8" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{DynamicResource Icons}" FontSize="14" Foreground="{DynamicResource WarnText}" Margin="0,1,10,0"/>
            <TextBlock x:Name="ConflictText" Foreground="{DynamicResource WarnText}" FontSize="12" TextWrapping="Wrap"/>
          </DockPanel>
        </Border>

        <!-- Большая карточка-переключатель: подсветка — отдельный слой, его прозрачность анимируется -->
        <Grid x:Name="PowerButton" DockPanel.Dock="Top" Margin="0,16,0,0" Height="148" Cursor="Hand" Background="Transparent">
          <Border x:Name="PowerBase" CornerRadius="22" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
          <Border x:Name="ActiveLayer" CornerRadius="22" BorderBrush="{DynamicResource ActiveBorder}" BorderThickness="1" Opacity="0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource ActiveFromColor}" Offset="0"/>
                <GradientStop Color="{DynamicResource ActiveToColor}" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
              <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>
          </Border>
          <Grid Margin="22,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="64" Height="64" VerticalAlignment="Center">
              <Border CornerRadius="20" Background="{DynamicResource IconBg}"/>
              <Border x:Name="PowerIconOn" CornerRadius="20" Background="{DynamicResource Accent}" Opacity="0"/>
              <TextBlock x:Name="PowerIcon" Text="&#xEA18;" FontFamily="{DynamicResource Icons}" FontSize="28" Foreground="{DynamicResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
              <TextBlock x:Name="PowerStatus" Text="Обход выключен" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="PowerTimer" Text=" " FontSize="12" Foreground="{DynamicResource TextSub}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="PowerHint" Text="Нажмите, чтобы включить" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
            </StackPanel>
            <Grid Grid.Column="2" Width="60" Height="32" VerticalAlignment="Center">
              <Border CornerRadius="16" Background="{DynamicResource TrackOff}"/>
              <Border x:Name="ToggleTrackOn" CornerRadius="16" Background="{DynamicResource Accent}" Opacity="0"/>
              <Ellipse x:Name="ToggleKnob" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="4,0">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
          </Grid>
        </Grid>

        <!-- Текущая стратегия -->
        <Border DockPanel.Dock="Top" Margin="0,12,0,0" CornerRadius="16" Background="{DynamicResource CardRaised}" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="CurrentBadgeBg" Width="38" Height="38" CornerRadius="11" Background="#3B82F6" VerticalAlignment="Center">
              <TextBlock x:Name="CurrentBadge" Text="G" FontSize="12" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <TextBlock Text="Стратегия" FontSize="11" Foreground="{DynamicResource Muted}"/>
              <TextBlock x:Name="CurrentName" Text="" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="BtnMain" Grid.Column="2" Style="{DynamicResource GhostButton}" Height="34" Content="Подобрать стратегию"/>
          </Grid>
        </Border>

        <!-- Доступность сайтов -->
        <Grid DockPanel.Dock="Top" Margin="2,18,0,8">
          <TextBlock Text="ДОСТУПНОСТЬ САЙТОВ" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
          <Button x:Name="BtnSiteCheck" Style="{DynamicResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE72C;"
                  HorizontalAlignment="Right" ToolTip="Проверить сейчас"/>
        </Grid>
        <UniformGrid x:Name="SitePanel" DockPanel.Dock="Top" Rows="1"/>
        <TextBlock DockPanel.Dock="Top" Text="HTTPS — время открытия сайта через обход, TCP — пинг до сервера. Линия — последние проверки" FontSize="10"
                   Foreground="{DynamicResource Faint}" Margin="2,6,0,0" TextWrapping="Wrap"/>

        <WrapPanel DockPanel.Dock="Bottom">
          <ToggleButton x:Name="ChipAutostart" Style="{DynamicResource Chip}" Content="Автозапуск"/>
          <ToggleButton x:Name="ChipAutoUpdate" Style="{DynamicResource Chip}" Content="Автообновление"/>
          <ToggleButton x:Name="ChipTelegram" Style="{DynamicResource Chip}" Content="Telegram"/>
        </WrapPanel>
      </DockPanel>
    </Grid>

    <!-- Экран первого запуска -->
    <Grid x:Name="Onboarding" Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource Overlay}" Visibility="Collapsed">
      <Border x:Name="OnbCard" Width="520" CornerRadius="22" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              Padding="34,30" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
          <Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
            <TextBlock x:Name="OnbIcon" Text="&#xEA18;" FontFamily="{DynamicResource Icons}" FontSize="32" Foreground="{DynamicResource AccentHover}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="OnbTitle" Text="" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="OnbText" Text="" FontSize="13" Foreground="{DynamicResource TextSub}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"/>
          <Grid Margin="0,26,0,0">
            <StackPanel x:Name="OnbDots" Orientation="Horizontal" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="OnbSkip" Style="{DynamicResource GhostButton}" Height="36" MinWidth="110" Content="Пропустить"/>
              <Button x:Name="OnbNext" Style="{DynamicResource AccentButton}" Height="36" MinWidth="130" Margin="8,0,0,0" Content="Дальше"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

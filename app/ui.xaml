      <!-- Журнал -->
      <Grid x:Name="PageLog" Grid.Row="1" Visibility="Collapsed" Margin="22,20,20,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <Grid>
            <TextBlock Text="Журнал" Style="{DynamicResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="BtnLogCopy" Style="{DynamicResource GhostButton}" Height="30" Content="Копировать" ToolTip="Скопировать показанные строки — например, чтобы отправить разработчику"/>
              <Button x:Name="BtnLogOpen" Style="{DynamicResource GhostButton}" Height="30" Margin="6,0,0,0" Content="Открыть файл" ToolTip="Открыть весь журнал в Блокноте"/>
              <Button x:Name="BtnLogReport" Style="{DynamicResource GhostButton}" Height="30" Margin="6,0,0,0" Content="Собрать отчёт"
                      ToolTip="Журналы и сведения о системе — одним архивом на рабочий стол, чтобы отправить разработчику. Ключи VPN, адрес подписки и файлы настроек в него не попадают"/>
              <Button x:Name="BtnLogIssue" Style="{DynamicResource GhostButton}" Height="30" Margin="6,0,0,0" Content="Сообщить о проблеме"
                      ToolTip="Сохранить отчёт и открыть страницу новой заявки на GitHub — версии уже будут заполнены, останется описать проблему и приложить архив"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="10" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="32">
              <Grid Margin="12,0">
                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Icons}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock x:Name="LogSearchHint" Text="Поиск в журнале" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
                <TextBox x:Name="LogSearch" Style="{DynamicResource InputBox}" Margin="22,0,0,0"/>
              </Grid>
            </Border>
            <ToggleButton x:Name="LogImportant" Grid.Column="1" Style="{DynamicResource Chip}" Margin="8,0,0,0" Content="Только важное"
                          ToolTip="Показать только ошибки и предупреждения"/>
          </Grid>
        </StackPanel>
        <!-- строки журнала: время отдельно, ошибки красным, предупреждения жёлтым -->
        <Border Grid.Row="1" CornerRadius="14" Background="{DynamicResource Card}" Padding="12,10,4,10">
          <Grid>
            <ContentControl x:Name="LogEmpty" Focusable="False" Visibility="Collapsed"/>
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="0,1,8,1"/>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86"/>
                      <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Faint}" Margin="0,1,0,0"/>
                    <TextBlock x:Name="msg" Grid.Column="1" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSub}"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="err">
                      <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource Danger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="trace">
                      <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource Danger}"/>
                      <Setter TargetName="msg" Property="FontFamily" Value="Consolas"/>
                      <Setter TargetName="msg" Property="FontSize" Value="11"/>
                      <Setter TargetName="msg" Property="Opacity" Value="0.75"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="warn">
                      <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource WarnText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="ok">
                      <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource AccentHover}"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

      <!-- Главная «Обход»: приветствие, карточка обхода, сторожевые карточки, сайты, стратегии, VPN, сутки -->
      <ScrollViewer x:Name="PageHome" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="10,6,28,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- ===== Ряд 1: приветствие, карточка обхода и три карточки-иллюстрации ===== -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300"/>
              <ColumnDefinition Width="1.4*"/>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="GlowBg" Grid.Column="1" Grid.ColumnSpan="2" Width="520" Height="380" Margin="-200,-140,-200,-140" Opacity="0" IsHitTestVisible="False">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="{DynamicResource GlowColor}" Offset="0"/>
                  <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>

            <!-- приветствие: текст — в UpdateGreeting; живой талисман (Launcher.Mascot.cs) — в строке с датой, заголовку остаётся вся ширина -->
            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="Mascot" Width="60" Height="56" Margin="0,0,12,0" Background="Transparent"/>
                <TextBlock x:Name="GreetDate" Text=" " FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="GreetTitle" Text=" " FontSize="31" FontWeight="Bold" LineHeight="37" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="GreetSub" Text=" " FontSize="13" Foreground="{DynamicResource TextSub}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="19"/>
              <WrapPanel Margin="0,14,0,0">
                <Border CornerRadius="18" Background="{DynamicResource CardRaised}" Padding="12,7" Margin="0,0,0,6" MaxWidth="300">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="NetIcon" Text="&#xE839;" FontFamily="{DynamicResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="NetStatus" Text=" " FontSize="11" Foreground="{DynamicResource TextSub}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </WrapPanel>
            </StackPanel>

            <!-- Карточка обхода: клик — включить или выключить; подсветка — отдельный слой, его прозрачность анимируется -->
            <Grid x:Name="PowerButton" Grid.Column="1" Height="200" Margin="0,0,14,0" Cursor="Hand" Background="Transparent">
              <Border x:Name="PowerBase" CornerRadius="24" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.10" Color="{DynamicResource ShadowColor}"/></Border.Effect>
              </Border>
              <Border x:Name="ActiveLayer" CornerRadius="24" Opacity="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                  <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.35"/>
                </Border.Effect>
              </Border>
              <!-- Жёлтый — пауза из-за VPN, красный — ошибка: цвет задаётся в коде -->
              <Border x:Name="StateLayer" CornerRadius="24" BorderThickness="1" Opacity="0"/>
              <!-- Волна при включении: расходится от кнопки внизу справа -->
              <Grid IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse x:Name="Ripple" Width="64" Height="64" Fill="{DynamicResource Accent}" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                         RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <StackPanel Margin="20,18,20,0">
                <TextBlock x:Name="PowerCaption" Text="ОБХОД" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Opacity="0.85"/>
                <TextBlock x:Name="PowerStatus" Text="Обход выключен" FontSize="21" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="58"/>
                <TextBlock x:Name="PowerTimer" Text=" " FontSize="12" Foreground="{DynamicResource TextSub}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PowerHint" Text="Нажмите, чтобы включить" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <!-- кнопка «питания» на плитке; пока обход работает — от неё расходится мягкое кольцо (PowerPulse), пока включается или идёт подбор — по контуру бежит полоска -->
              <Grid Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16">
                <Border x:Name="PowerPulse" CornerRadius="20" BorderBrush="White" BorderThickness="2" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"/>
                <Border CornerRadius="20" Background="{DynamicResource IconBg}"/>
                <Border x:Name="PowerIconOn" CornerRadius="20" Background="{DynamicResource CardRaised}" Opacity="0">
                  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="White"/></Border.Effect>
                </Border>
                <TextBlock x:Name="PowerIcon" Text="&#xE7E8;" FontFamily="{DynamicResource Icons}" FontSize="26" Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- Периметр контура (74×74, радиус 24) ≈ 255 px = 85 толщин линии — сумма штриха и пробела ровно один круг -->
                <Rectangle x:Name="BusyRing" Margin="-5" RadiusX="24" RadiusY="24" StrokeThickness="3" Stroke="{DynamicResource Accent}"
                           StrokeDashArray="22 63" StrokeDashCap="Round" Opacity="0" IsHitTestVisible="False"/>
              </Grid>
              <!-- Прогресс подбора стратегии -->
              <Grid x:Name="PickProgress" VerticalAlignment="Bottom" Height="4" Margin="20,0,90,18" Visibility="Collapsed" IsHitTestVisible="False">
                <Border CornerRadius="2" Background="{DynamicResource TrackOff}"/>
                <Border x:Name="PickFill" CornerRadius="2" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform>
                    <ScaleTransform ScaleX="0"/>
                  </Border.RenderTransform>
                </Border>
              </Grid>
            </Grid>

            <!-- карточка «Стратегия»: клик — весь список стратегий -->
            <Grid x:Name="IllStrat" Grid.Column="2" Height="200" Margin="0,0,14,0" Cursor="Hand" Background="Transparent">
              <Border CornerRadius="24" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.08" Color="{DynamicResource ShadowColor}"/></Border.Effect>
              </Border>
              <Grid Margin="16">
                <Grid Height="100" VerticalAlignment="Top">
                  <Ellipse x:Name="IllStratCircle" Width="92" Height="92" Fill="{DynamicResource AccentSoft}"/>
                  <Border Width="66" Height="50" CornerRadius="10" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource Text}" BorderThickness="2" Margin="-22,-6,0,0">
                    <StackPanel Margin="9,9,0,0">
                      <Rectangle Width="34" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                      <Rectangle Width="24" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource TrackOff}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                      <Rectangle Width="30" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource TrackOff}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Text}" BorderThickness="2" Margin="58,44,0,0">
                    <TextBlock x:Name="IllStratCheck" Text="&#xE73E;" RenderTransformOrigin="0.5,0.5" FontFamily="{DynamicResource Icons}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock x:Name="IllStratTitle" Text=" " FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="IllStratSub" Text=" " FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </Grid>

            <!-- карточка «VPN»: клик — страница VPN -->
            <Grid x:Name="IllVpn" Grid.Column="3" Height="200" Margin="0,0,14,0" Cursor="Hand" Background="Transparent">
              <Border CornerRadius="24" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.08" Color="{DynamicResource ShadowColor}"/></Border.Effect>
              </Border>
              <Grid Margin="16">
                <Grid Height="100" VerticalAlignment="Top">
                  <Ellipse x:Name="IllVpnCircle" Width="92" Height="92" Fill="{DynamicResource AccentSoft}"/>
                  <Ellipse Width="60" Height="60" Fill="{DynamicResource CardRaised}" Stroke="{DynamicResource Text}" StrokeThickness="2"/>
                  <!-- VPN подключается — пунктир вокруг глобуса крутится (UpdateIllustrations) -->
                  <Ellipse x:Name="IllVpnSpin" Width="74" Height="74" Stroke="{DynamicResource Accent}" StrokeThickness="3" StrokeDashArray="3 4" StrokeDashCap="Round" Opacity="0" RenderTransformOrigin="0.5,0.5"/>
                  <TextBlock x:Name="IllVpnGlobe" Text="&#xE909;" FontFamily="{DynamicResource Icons}" FontSize="32" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Border x:Name="IllVpnBadge" MinWidth="40" Height="22" CornerRadius="11" Background="{DynamicResource Ok}" BorderBrush="{DynamicResource Text}" BorderThickness="2" Margin="62,56,0,0" Padding="5,0" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="IllVpnBadgeText" Text="" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock x:Name="IllVpnTitle" Text=" " FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="IllVpnSub" Text=" " FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </Grid>

            <!-- карточка «Сторож»: клик — настройки -->
            <Grid x:Name="IllWatch" Grid.Column="4" Height="200" Cursor="Hand" Background="Transparent">
              <Border CornerRadius="24" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.08" Color="{DynamicResource ShadowColor}"/></Border.Effect>
              </Border>
              <Grid Margin="16">
                <Grid Height="100" VerticalAlignment="Top">
                  <Ellipse x:Name="IllWatchCircle" Width="92" Height="92" Fill="{DynamicResource AccentSoft}"/>
                  <Path x:Name="IllWatchShield" Width="52" Height="60" Stretch="Fill" Fill="{DynamicResource CardRaised}" Stroke="{DynamicResource Text}" StrokeThickness="2"
                        Data="M50,8 C64,16 76,18 88,18 L88,46 C88,70 72,86 50,94 C28,86 12,70 12,46 L12,18 C24,18 36,16 50,8 Z"/>
                  <TextBlock x:Name="IllWatchCheck" Text="&#xE8FB;" FontFamily="{DynamicResource Icons}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </Grid>
                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock x:Name="IllWatchTitle" Text=" " FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="IllWatchSub" Text=" " FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>

          <!-- ===== Ряд 2: карточки сайтов (строит код) ===== -->
          <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Margin="2,0,0,8">
              <TextBlock Text="ДОСТУПНОСТЬ САЙТОВ" Style="{DynamicResource Caption}" VerticalAlignment="Center" Background="Transparent"
                         ToolTip="Крупно — время открытия сайта через обход, TCP — пинг до сервера. Линия — последние проверки"/>
              <Button x:Name="BtnWhy" Style="{DynamicResource LinkButton}" Content="Почему не работает?" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,36,0"
                      ToolTip="Проверить по шагам интернет, DNS, мешающие программы, обход и сайты — и подсказать, что исправить"/>
              <Button x:Name="BtnSiteCheck" Style="{DynamicResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE72C;"
                      HorizontalAlignment="Right" ToolTip="Проверить сайты сейчас"/>
            </Grid>
            <UniformGrid x:Name="SitePanel" Grid.Row="1"/>
          </Grid>

          <!-- ===== Ряд 3 во время подбора: «гонка стратегий» — у каждой дорожка, сколько сайтов открыла, лидер ===== -->
          <Border x:Name="PickRace" Grid.Row="3" Margin="0,22,0,0" CornerRadius="24" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1"
                  Padding="22,18,22,14" Visibility="Collapsed">
            <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.08" Color="{DynamicResource ShadowColor}"/></Border.Effect>
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="RaceCount" DockPanel.Dock="Right" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="RaceTitle" Text="Гонка стратегий" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
              </DockPanel>
              <TextBlock x:Name="RaceLeader" Text=" " FontSize="12.5" Foreground="{DynamicResource TextSub}" Margin="0,4,0,10" TextTrimming="CharacterEllipsis"/>
              <UniformGrid x:Name="RaceLanes" Columns="2"/>
            </StackPanel>
          </Border>

          <!-- ===== Ряд 3: стратегии, VPN, последние сутки ===== -->
          <Grid x:Name="HomeRow3" Grid.Row="3" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.15*"/>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- стратегии: текущая и запасная, «все N» — полный список -->
            <Grid Margin="0,0,14,0">
              <Border CornerRadius="24" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.08" Color="{DynamicResource ShadowColor}"/></Border.Effect>
              </Border>
              <StackPanel Margin="18,16">
                <Grid>
                  <TextBlock Text="Стратегии" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button x:Name="HomeAllStrategies" Style="{DynamicResource LinkButton}" Content="›" HorizontalAlignment="Right"/>
                </Grid>
                <Border Margin="0,12,0,0" CornerRadius="14" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Padding="12,8,6,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CurrentBadgeBg" Width="34" Height="34" CornerRadius="10" Background="#3B82F6" VerticalAlignment="Center">
                      <TextBlock x:Name="CurrentBadge" Text="G" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center">
                      <TextBlock x:Name="CurrentName" Text="" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="CurrentFile" Text="" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="BtnQuickPick" Grid.Column="2" Style="{DynamicResource IconButton}" Width="32" Height="32" FontSize="14" Content="&#xE734;" Foreground="{DynamicResource Wait}"
                            ToolTip="Быстрый подбор по избранному: проверить только стратегии со звёздочкой"/>
                  </Grid>
                </Border>
                <!-- запасная: избранная или лучшая по последнему подбору; клик — переключиться на неё -->
                <Border x:Name="HomeAlt" Margin="0,6,0,0" CornerRadius="14" Padding="13.5,9.5,8,9.5" Cursor="Hand" Background="Transparent" Visibility="Collapsed" ToolTip="Переключиться на эту стратегию">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HomeAltBadgeBg" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource IconBg}" VerticalAlignment="Center">
                      <TextBlock x:Name="HomeAltBadge" Text="" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="HomeAltName" Text="" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="HomeAltSub" Text="" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>

            <!-- VPN: сервер, пинг, скорость; переключатель — тот же, что раньше был чипом -->
            <Grid x:Name="HomeVpnCard" Grid.Column="1" Margin="0,0,14,0" Cursor="Hand" Background="Transparent">
              <Border CornerRadius="24" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.08" Color="{DynamicResource ShadowColor}"/></Border.Effect>
              </Border>
              <StackPanel Margin="18,16">
                <Grid>
                  <TextBlock Text="VPN" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <ToggleButton x:Name="ChipVpn" Style="{DynamicResource MiniSwitch}" HorizontalAlignment="Right" ToolTip="Встроенный VPN: сайты и программы из списка на странице VPN"/>
                </Grid>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="HomeVpnFlag" Width="34" Height="24" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HomeVpnName" Text=" " FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HomeVpnInfo" Text=" " FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
                <Canvas x:Name="HomeVpnGraph" Height="30" Margin="0,12,0,0" ClipToBounds="True"/>
                <TextBlock x:Name="HomeVpnSpeed" Text=" " FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>

            <!-- последние сутки: полоса (слева — сутки назад, справа — сейчас), легенда и быстрые переключатели -->
            <Grid Grid.Column="2">
              <Border CornerRadius="24" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.08" Color="{DynamicResource ShadowColor}"/></Border.Effect>
              </Border>
              <StackPanel Margin="18,16">
                <Grid>
                  <TextBlock Text="Последние сутки" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock x:Name="HistoryMonth" Text="" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <Border CornerRadius="6" Background="{DynamicResource IconBg}" Height="12" ClipToBounds="True"
                            ToolTip="Слева — сутки назад, справа — сейчас. Наведите на отрезок, чтобы увидеть время">
                      <Canvas x:Name="HistoryBar"/>
                    </Border>
                    <WrapPanel x:Name="HistoryLegend" Margin="0,10,0,0"/>
                  </StackPanel>
                  <!-- доля суток, когда обход работал: кольцо рисуется в RenderHistory -->
                  <Grid Grid.Column="1" Width="64" Height="64" Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="Доля суток, когда обход работал">
                    <Ellipse Stroke="{DynamicResource IconBg}" StrokeThickness="7"/>
                    <Path x:Name="HistoryRing" Stroke="{DynamicResource Accent}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Path.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" Color="{DynamicResource AccentColor}"/></Path.Effect>
                    </Path>
                    <TextBlock x:Name="HistoryPercent" Text="" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                  <ToggleButton x:Name="ChipAutostart" Style="{DynamicResource Chip}" Content="Автозапуск" Margin="0,0,6,6"/>
                  <ToggleButton x:Name="ChipAutoUpdate" Style="{DynamicResource Chip}" Content="Автообновление" Margin="0,0,6,6"/>
                  <ToggleButton x:Name="ChipTelegram" Style="{DynamicResource Chip}" Content="Telegram" Margin="0,0,6,6"/>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Экран первого запуска -->
    <Grid x:Name="Onboarding" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource Overlay}" Visibility="Collapsed">
      <Border x:Name="OnbCard" Width="540" CornerRadius="26" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1"
              Padding="34,30" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
          <Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
            <TextBlock x:Name="OnbIcon" Text="&#xEA18;" FontFamily="{DynamicResource Icons}" FontSize="32" Foreground="{DynamicResource AccentHover}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="OnbTitle" Text="" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="OnbText" Text="" FontSize="13" Foreground="{DynamicResource TextSub}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"/>
          <!-- Картинка шага: рисуется кодом из элементов интерфейса, поэтому сама подстраивается под тему -->
          <Border x:Name="OnbPicture" Margin="0,18,0,0" Visibility="Collapsed"/>
          <Grid Margin="0,26,0,0">
            <StackPanel x:Name="OnbDots" Orientation="Horizontal" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="OnbSkip" Style="{DynamicResource GhostButton}" Height="36" MinWidth="110" Content="Пропустить"/>
              <Button x:Name="OnbNext" Style="{DynamicResource AccentButton}" Height="36" MinWidth="130" Margin="8,0,0,0" Content="Дальше"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

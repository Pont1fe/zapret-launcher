<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret Launcher" Width="1240" Height="760" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" RenderOptions.BitmapScalingMode="HighQuality">

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="68"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="86"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- своя картинка за окном (Настройки → Вид): размыта, края с запасом — размытие не оставляет светлой рамки; панели над ней полупрозрачные -->
    <!-- обрезка по окну: иначе запас по краям попал бы в снимок окна при смене темы, и окно на миг «съёживалось» -->
    <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False">
      <Image x:Name="Wallpaper" Margin="-60" Stretch="UniformToFill" Visibility="Collapsed">
        <Image.Effect><BlurEffect Radius="30" KernelType="Gaussian"/></Image.Effect>
      </Image>
    </Grid>

    <!-- Верхняя панель вместо заголовка окна: за пустое место окно перетаскивается (WindowChrome), кнопки и поле — кликабельны -->
    <Grid Grid.ColumnSpan="2" Background="{DynamicResource MidBg}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <!-- логотип; версия — в подсказке (TitleText и TitleIcon заполняет код) -->
      <Border Width="40" Height="40" CornerRadius="13" Margin="22,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Text, ElementName=TitleText}" WindowChrome.IsHitTestVisibleInChrome="True">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <!-- логотип лаунчера, как у значка программы и в трее (Icons.Draw): белый щит с «Z», нарисован линиями — строго по центру;
               координаты 0..100, щит занимает 12..88 × 8..94 -->
          <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="100" Height="100">
              <Path Fill="White" Data="M50,8 C64,16 76,18 88,18 L88,46 C88,70 72,86 50,94 C28,86 12,70 12,46 L12,18 C24,18 36,16 50,8 Z"/>
              <Path Stroke="{DynamicResource Accent}" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M35,33 L65,33 L35,67 L65,67"/>
            </Canvas>
          </Viewbox>
          <Image x:Name="TitleIcon" Visibility="Collapsed"/>
          <TextBlock x:Name="TitleText" Text="" Visibility="Collapsed"/>
        </Grid>
      </Border>
      <Border Grid.Column="2" MaxWidth="360" Height="38" Margin="40,0,0,0" HorizontalAlignment="Stretch" CornerRadius="12" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid Margin="12,0">
          <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <TextBlock x:Name="TopSearchHint" Text="Найти стратегию" Foreground="{DynamicResource Faint}" FontSize="12.5" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
          <TextBox x:Name="TopSearch" Style="{DynamicResource InputBox}" Margin="22,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>
      </Border>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
        <Button x:Name="BtnReport" Style="{DynamicResource GhostButton}" Height="38" Content="Отчёт" WindowChrome.IsHitTestVisibleInChrome="True"
                ToolTip="Собрать отчёт для разработчика на рабочий стол: журнал и настройки без ключей"/>
        <Button x:Name="BtnMain" Style="{DynamicResource InkButton}" Height="38" Margin="8,0,0,0" Content="Подобрать стратегию" WindowChrome.IsHitTestVisibleInChrome="True"/>
      </StackPanel>
      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="BtnMinimize" Style="{DynamicResource ChromeButton}" Content="&#xE921;" ToolTip="Свернуть"/>
        <Button x:Name="BtnMaximize" Style="{DynamicResource ChromeButton}" Content="&#xE922;" ToolTip="Развернуть"/>
        <Button x:Name="BtnClose" Style="{DynamicResource ChromeButton}" Content="&#xE8BB;" ToolTip="Закрыть"/>
      </StackPanel>
    </Grid>

    <!-- Боковое меню: плавающая панель цвета акцента с волнистым краем -->
    <Grid x:Name="Sidebar" Grid.Row="1" Background="{DynamicResource MidBg}">
      <Path Stretch="Fill" Margin="0,4,8,8" IsHitTestVisible="False" Data="M0,0 C34,4 76,16 76,52 L76,468 C76,504 34,516 0,520 Z">
        <Path.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
          </LinearGradientBrush>
        </Path.Fill>
        <Path.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="0" Opacity="0.30" Color="{DynamicResource AccentColor}"/></Path.Effect>
      </Path>
      <!-- Все иконки одной колонкой по центру фиолетовой панели; плитка в одной сетке с пунктами, чтобы не отставать при ресайзе -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,8,8">
      <Grid x:Name="NavGroup">
      <!-- Выбранный пункт: белая плитка, плавно переезжает к нему -->
      <Border x:Name="NavPill" Width="52" Height="52" CornerRadius="16" Background="{DynamicResource CardRaised}"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" IsHitTestVisible="False">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#000000"/></Border.Effect>
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
      </Border>
      <StackPanel x:Name="NavPanel" HorizontalAlignment="Center">
        <RadioButton x:Name="NavHome" Style="{DynamicResource NavButton}" Content="&#xE774;" Tag="Обход" IsChecked="True"/>
        <RadioButton x:Name="NavVpn" Style="{DynamicResource NavButton}" Content="&#xE909;" Tag="VPN"/>
        <RadioButton x:Name="NavDomains" Style="{DynamicResource NavButton}" Content="&#xE71B;" Tag="Домены"/>
        <RadioButton x:Name="NavSettings" Style="{DynamicResource NavButton}" Content="&#xE713;" Tag="Настройки"/>
        <RadioButton x:Name="NavLog" Style="{DynamicResource NavButton}" Content="&#xE8A5;" Tag="Журнал"/>
      </StackPanel>
      </Grid>
      <Border Width="28" Height="1" Margin="0,12" Background="#40FFFFFF"/>
        <Button x:Name="NavFolder" Style="{DynamicResource SideButton}" Width="52" Height="52" Margin="0,3" FontSize="18" Content="&#xE8B7;" ToolTip="Папка zapret"/>
        <Button x:Name="NavInfo" Style="{DynamicResource SideButton}" Width="52" Height="52" Margin="0,3" FontSize="18" Content="&#xE946;" ToolTip="Страница лаунчера на GitHub"/>
      </StackPanel>
    </Grid>

    <!-- Средняя панель -->
    <Grid x:Name="MidPanel" Grid.Row="1" Grid.Column="1" Background="{DynamicResource MidBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <!-- Предупреждения — тонкими строками над любой страницей: конфликт программ и смена стратегии сторожем -->
      <StackPanel Margin="22,0,24,0">
        <Border x:Name="ConflictBar" Margin="0,12,0,0" CornerRadius="9" Background="{DynamicResource WarnBg}"
                BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1" Padding="10,5" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{DynamicResource Icons}" FontSize="12" Foreground="{DynamicResource WarnText}" Margin="0,1,8,0" VerticalAlignment="Center"/>
            <Button x:Name="BtnFixConflict" DockPanel.Dock="Right" Content="Исправить" Cursor="Hand" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="b" CornerRadius="6" Padding="9,2" Background="Transparent" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1"
                          TextElement.Foreground="{DynamicResource WarnText}" TextElement.FontSize="11" TextElement.FontWeight="SemiBold">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Background" Value="{DynamicResource WarnBorder}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <TextBlock x:Name="ConflictText" Foreground="{DynamicResource WarnText}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <!-- Сторож сменил стратегию — можно вернуть прежнюю -->
        <Border x:Name="StrategyChangedBar" Margin="0,12,0,0" CornerRadius="9" Background="{DynamicResource AccentSoft}"
                BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Padding="10,4,4,4" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE8AB;" FontFamily="{DynamicResource Icons}" FontSize="12" Foreground="{DynamicResource AccentHover}" Margin="0,1,8,0" VerticalAlignment="Center"/>
            <Button x:Name="BtnStrategyChangedClose" DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Width="24" Height="24" FontSize="9" Content="&#xE711;" ToolTip="Скрыть"/>
            <Button x:Name="BtnRevertStrategy" DockPanel.Dock="Right" Style="{DynamicResource GhostButton}" Height="24" Margin="8,0,4,0" Content="Вернуть прежнюю"/>
            <TextBlock x:Name="StrategyChangedText" Foreground="{DynamicResource Text}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- Стратегии -->
      <Grid x:Name="PageStrategies" Grid.Row="1" Visibility="Collapsed" Margin="22,20,20,14" MaxWidth="900">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,6,0">
          <TextBlock Text="Стратегии" Style="{DynamicResource PageTitle}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="BtnInstallUpdate" Style="{DynamicResource IconButton}" Content="&#xE896;" Foreground="{DynamicResource AccentHover}"
                    ToolTip="Установить обновление zapret" Visibility="Collapsed"/>
            <Button x:Name="BtnCheck" Style="{DynamicResource IconButton}" Content="&#xE72C;" ToolTip="Проверить обновления"/>
          </StackPanel>
        </Grid>
        <DockPanel Grid.Row="1" Margin="0,6,0,0" LastChildFill="True">
          <Border DockPanel.Dock="Left" CornerRadius="6" Background="{DynamicResource Card}" Padding="8,2" VerticalAlignment="Center">
            <TextBlock x:Name="VersionPill" Text="" FontSize="11"/>
          </Border>
          <TextBlock x:Name="LatestText" DockPanel.Dock="Left" Text="" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
          <!-- не влезает — многоточие, полный текст в подсказке -->
          <TextBlock x:Name="CardSubtitle" Text="" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,14,6,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border CornerRadius="10" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="38">
            <Grid Margin="12,0">
              <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Icons}" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock x:Name="SearchHint" Text="Поиск стратегии" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
              <TextBox x:Name="SearchBox" Style="{DynamicResource InputBox}" Margin="22,0,0,0"/>
            </Grid>
          </Border>
          <Button x:Name="BtnPing" Grid.Column="1" Style="{DynamicResource GhostButton}" Height="38" Margin="8,0,0,0" ToolTip="Заново проверить сайты и пинг">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock x:Name="PingText" Text="Обновить" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>

        <ContentControl x:Name="StrategyEmpty" Grid.Row="3" Focusable="False" Visibility="Collapsed" VerticalAlignment="Top"/>
        <ListBox x:Name="StrategyList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{DynamicResource StrategyItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
          <ListBox.GroupStyle>
            <GroupStyle>
              <!-- Группа сворачивается кликом по заголовку; начальное состояние — из настроек (GroupOpen первой стратегии группы) -->
              <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                          <ToggleButton x:Name="Head" Style="{DynamicResource GroupHeader}" Tag="{Binding Name}"
                                        IsChecked="{Binding Items[0].GroupOpen, Mode=OneTime}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Name}"/>
                              <TextBlock Text="{Binding ItemCount}" Margin="6,0,0,0" Foreground="{DynamicResource Faint}"/>
                            </StackPanel>
                          </ToggleButton>
                          <ItemsPresenter x:Name="Items"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                          <Trigger SourceName="Head" Property="IsChecked" Value="False">
                            <Setter TargetName="Items" Property="Visibility" Value="Collapsed"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="500" ToolTipService.ShowDuration="20000">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="{Binding Color}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Ellipse Width="6" Height="6" Fill="{Binding MarkColor}" Visibility="{Binding MarkVisibility}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Style="{DynamicResource IconButton}" Width="30" Height="30" FontSize="14"
                        Content="{Binding StarGlyph}" Foreground="{Binding StarColor}" Tag="{Binding File}" ToolTip="{Binding StarTip}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Домены -->
      <Grid x:Name="PageDomains" Grid.Row="1" Visibility="Collapsed" Margin="22,20,20,14" MaxWidth="900">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Домены" Style="{DynamicResource PageTitle}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
          <RadioButton x:Name="DomGeneral" Style="{DynamicResource Segment}" GroupName="dom" Content="Обходить" IsChecked="True"/>
          <RadioButton x:Name="DomExclude" Style="{DynamicResource Segment}" GroupName="dom" Content="Не трогать"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border CornerRadius="10" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Background="{DynamicResource Input}" Height="38">
            <Grid Margin="12,0,3,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="DomainHint" Text="Например: site.ru" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
              <TextBox x:Name="DomainInput" Style="{DynamicResource InputBox}" Margin="-2,0,0,0"/>
              <Button x:Name="BtnDomainFile" Grid.Column="1" Style="{DynamicResource IconButton}" Width="30" Height="30" FontSize="14" Content="&#xE8E5;"
                      ToolTip="Добавить списком из файла (.txt) — по домену на строку"/>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BtnCheckDomain" Style="{DynamicResource GhostButton}" Height="38" Margin="8,0,0,0" Content="Проверить"
                    ToolTip="Проверить, открывается ли сайт сейчас"/>
            <Button x:Name="BtnAddDomain" Style="{DynamicResource AccentButton}" Height="38" Margin="8,0,0,0" Content="Добавить"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="DomainInfo" Grid.Row="3" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,8,0,12" TextWrapping="Wrap"
                   Text="Можно сразу несколько — через пробел, запятую или вставить списком. Поддомены учитываются автоматически."/>
        <!-- Готовые наборы: все домены сервиса одной кнопкой -->
        <StackPanel x:Name="DomainPresetBox" Grid.Row="4" Margin="0,0,0,10">
          <TextBlock Text="Готовые наборы" Style="{DynamicResource Caption}" Margin="2,0,0,8"/>
          <StackPanel x:Name="DomainPresets"/>
        </StackPanel>
        <Grid Grid.Row="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <!-- Поиск — когда доменов много -->
          <Border x:Name="DomainSearchBox" CornerRadius="10" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="34" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid Margin="12,0">
              <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Icons}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock x:Name="DomainSearchHint" Text="Поиск по списку" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
              <TextBox x:Name="DomainSearch" Style="{DynamicResource InputBox}" Margin="22,0,0,0"/>
            </Grid>
          </Border>
          <ContentControl x:Name="DomainEmpty" Grid.Row="1" Focusable="False" Visibility="Collapsed"/>
          <!-- включённые наборы — карточкой, остальные домены — по строке -->
          <ScrollViewer x:Name="DomainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DomainItems" Margin="0,0,6,0"/>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- VPN -->
      <ScrollViewer x:Name="PageVpn" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,20,14" MaxWidth="860">
          <TextBlock Text="VPN" Style="{DynamicResource PageTitle}"/>
          <TextBlock Text="Через ваш сервер или подписку. Выбранные сайты и программы идут через VPN, остальное — напрямую и через обход" Style="{DynamicResource RowSub}" Margin="0,6,0,0"/>

          <!-- Карточка подключения: флаг страны, состояние, время, скорость; клик — включить или выключить -->
          <Grid x:Name="VpnCard" Margin="0,16,0,0" MinHeight="118" Cursor="Hand" Background="Transparent">
            <Border CornerRadius="24" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
              <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.10" Color="{DynamicResource ShadowColor}"/></Border.Effect>
            </Border>
            <Border x:Name="VpnCardOn" CornerRadius="24" Opacity="0">   <!-- подключён — карточка цвета акцента, как карточка обхода на главной -->
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                  <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.35"/></Border.Effect>
            </Border>
            <!-- вспышка после подключения и бегущая по краю полоска, пока VPN подключается -->
            <Border x:Name="VpnFlash" CornerRadius="24" Background="White" Opacity="0" IsHitTestVisible="False"/>
            <Rectangle x:Name="VpnBusyLine" RadiusX="24" RadiusY="24" StrokeThickness="2" Stroke="{DynamicResource Accent}" StrokeDashArray="24 96"
                       StrokeDashCap="Round" Opacity="0" IsHitTestVisible="False"/>
            <Grid Margin="20,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="VpnFlagHost" Width="54" Height="38" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="VpnDot" Width="9" Height="9" Fill="{DynamicResource Idle}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                  <TextBlock x:Name="VpnStatus" Text="VPN выключен" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="VpnSub" Text=" " FontSize="12" Foreground="{DynamicResource TextSub}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="VpnTimer" Text=" " FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="VpnTraffic" Text=" " FontSize="11" Foreground="{DynamicResource TextSub}" Margin="0,2,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
              </StackPanel>
              <Grid Grid.Column="2" Width="60" Height="32" VerticalAlignment="Center">
                <Border CornerRadius="16" Background="{DynamicResource TrackOff}"/>
                <Border x:Name="VpnTrackOn" CornerRadius="16" Background="#59FFFFFF" Opacity="0"/>
                <Ellipse x:Name="VpnKnob" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="4,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform X="0"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
            </Grid>
          </Grid>
          <!-- скорость загрузки через VPN за последние минуты -->
          <Canvas x:Name="VpnGraph" Height="38" Margin="6,8,6,0" Visibility="Collapsed" ClipToBounds="True"/>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <RadioButton x:Name="VpnTabServers" Style="{DynamicResource Segment}" GroupName="vpntab" Content="Серверы" IsChecked="True"/>
            <RadioButton x:Name="VpnTabRoutes" Style="{DynamicResource Segment}" GroupName="vpntab" Content="Маршруты"/>
            <RadioButton x:Name="VpnTabConn" Style="{DynamicResource Segment}" GroupName="vpntab" Content="Соединения"/>
          </StackPanel>

          <!-- Вкладка «Серверы» -->
          <StackPanel x:Name="VpnPaneServers" Margin="0,14,0,0">
            <!-- Подсказка при первом открытии -->
            <Border x:Name="VpnHelp" CornerRadius="14" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                    Padding="16,13" Margin="0,0,0,12" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <TextBlock Text="Как начать" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button x:Name="BtnVpnHelpOk" Style="{DynamicResource GhostButton}" Height="28" HorizontalAlignment="Right" Content="Понятно"/>
                </Grid>
                <TextBlock Text="1.  Вставьте ключ или адрес подписки ниже — или откройте QR-код" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="2.  Во вкладке «Маршруты» выберите, что пускать через VPN" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="3.  Нажмите на карточку VPN выше — и готово" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <!-- В буфере обмена лежит ключ — предлагаем добавить -->
            <Border x:Name="VpnClipBar" CornerRadius="10" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                    Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VpnClipText" Text="В буфере обмена есть ключ VPN" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="BtnVpnClipAdd" Grid.Column="1" Style="{DynamicResource AccentButton}" Height="30" Margin="10,0,0,0" Content="Добавить"/>
              </Grid>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border CornerRadius="10" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Background="{DynamicResource Input}" Height="38">
                <Grid Margin="12,0">
                  <TextBlock x:Name="VpnHint" Text="Ключ vless://, vmess://, trojan://, ss://… или адрес подписки" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                  <TextBox x:Name="VpnInput" Style="{DynamicResource InputBox}" Margin="-2,0,0,0"/>
                </Grid>
              </Border>
              <Button x:Name="BtnVpnAdd" Grid.Column="1" Style="{DynamicResource AccentButton}" Height="38" Margin="8,0,0,0" Content="Добавить"/>
            </Grid>
            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="BtnVpnQrFile" Style="{DynamicResource GhostButton}" Height="30" Margin="0,0,8,0" Content="QR из картинки…" ToolTip="Открыть картинку или скриншот с QR-кодом ключа"/>
              <Button x:Name="BtnVpnQrScreen" Style="{DynamicResource GhostButton}" Height="30" Margin="0,0,8,0" Content="Найти QR на экране" ToolTip="Откройте QR-код ключа в любом окне и нажмите — лаунчер найдёт его на экране"/>
              <Button x:Name="BtnVpnAwgFile" Style="{DynamicResource GhostButton}" Height="30" Content="Файл AmneziaWG…" ToolTip="Файл .conf из приложения Amnezia (подписка → «Файлы конфигурации») или от своего сервера AmneziaWG"/>
            </WrapPanel>
            <TextBlock x:Name="VpnInfo" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,8,0,10" TextWrapping="Wrap"
                       Text="Ключи хранятся только на этом компьютере, в настройках лаунчера"/>
            <!-- Подписка: сколько трафика осталось и до какого числа -->
            <Border x:Name="VpnSubCard" CornerRadius="10" Background="{DynamicResource Card}" Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <TextBlock x:Name="VpnSubText" Text=" " FontSize="12"/>
                  <TextBlock x:Name="VpnSubExpire" Text=" " FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                </Grid>
                <Border x:Name="VpnSubBarBg" CornerRadius="3" Background="{DynamicResource IconBg}" Height="6" Margin="0,7,0,0">
                  <Border x:Name="VpnSubBar" CornerRadius="3" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="0"/>
                </Border>
              </StackPanel>
            </Border>
            <!-- Поиск — когда серверов много -->
            <Border x:Name="VpnSearchBox" CornerRadius="10" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="34" Margin="0,0,0,10" Visibility="Collapsed">
              <Grid Margin="12,0">
                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Icons}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock x:Name="VpnSearchHint" Text="Поиск сервера или страны" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
                <TextBox x:Name="VpnSearch" Style="{DynamicResource InputBox}" Margin="22,0,0,0"/>
              </Grid>
            </Border>
            <WrapPanel x:Name="VpnTabs" Margin="0,0,0,4" Visibility="Collapsed"/>
            <StackPanel x:Name="VpnServerList"/>
            <WrapPanel Margin="0,4,0,0">
              <Button x:Name="BtnVpnPing" Style="{DynamicResource GhostButton}" Height="32" Margin="0,0,8,6" Content="Проверить серверы" ToolTip="Открыть тестовую страницу через каждый сервер и замерить время"/>
              <Button x:Name="BtnVpnBest" Style="{DynamicResource GhostButton}" Height="32" Margin="0,0,8,6" Content="Выбрать самый быстрый"/>
              <Button x:Name="BtnVpnSpeed" Style="{DynamicResource GhostButton}" Height="32" Margin="0,0,8,6" Content="Проверить скорость"
                      ToolTip="Скачать тестовый файл через выбранный сервер и самые быстрые по проверке (до 5, по 5 секунд на каждый). VPN при этом не переподключается"/>
              <Button x:Name="BtnVpnRefresh" Style="{DynamicResource GhostButton}" Height="32" Margin="0,0,8,6" Content="Обновить подписку" Visibility="Collapsed"/>
              <ToggleButton x:Name="VpnHideDead" Style="{DynamicResource Chip}" Height="32" Margin="0,0,8,6" Content="Скрыть неработающие" Visibility="Collapsed"
                            ToolTip="Не показывать серверы, через которые при последней проверке сайт не открылся. Выбранный сервер виден всегда"/>
            </WrapPanel>
            <Border Style="{DynamicResource SettingsCard}" Margin="0,6,0,0">
              <CheckBox x:Name="SwVpnAuto" Style="{DynamicResource Switch}" BorderThickness="0" Tag="&#xE8B1;">
                <StackPanel>
                  <TextBlock Text="Автовыбор сервера" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="При подключении — самый быстрый сервер; если он перестал отвечать, VPN сам перейдёт на другой" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
            </Border>
          </StackPanel>

          <!-- Вкладка «Маршруты» -->
          <StackPanel x:Name="VpnPaneRoutes" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="VpnModeSplit" Style="{DynamicResource Segment}" GroupName="vpnmode" Content="Только выбранное"/>
              <RadioButton x:Name="VpnModeRu" Style="{DynamicResource Segment}" GroupName="vpnmode" Content="Россия напрямую"/>
              <RadioButton x:Name="VpnModeAll" Style="{DynamicResource Segment}" GroupName="vpnmode" Content="Весь трафик"/>
            </StackPanel>
            <TextBlock x:Name="VpnModeText" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,8,0,0" TextWrapping="Wrap" Text=" "/>
            <Border Style="{DynamicResource SettingsCard}" Margin="0,12,0,0">
              <CheckBox x:Name="SwVpnKill" Style="{DynamicResource Switch}" BorderThickness="0" Tag="&#xE72E;">
                <StackPanel>
                  <TextBlock Text="Не пускать мимо VPN" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Если VPN упал и не поднимается, сайты и программы из списка не откроются напрямую, пока он не заработает. В режимах «Весь трафик» и «Россия напрямую» блокируется всё, что шло через VPN" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
            </Border>
            <!-- Сайты, которые провайдер режет по адресу: одной кнопкой — через VPN -->
            <Border x:Name="VpnBlockedBar" CornerRadius="10" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                    Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VpnBlockedText" Text=" " FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Name="BtnVpnAddBlocked" Grid.Column="1" Style="{DynamicResource AccentButton}" Height="30" Margin="10,0,0,0" Content="Через VPN"/>
              </Grid>
            </Border>
            <StackPanel x:Name="VpnSplitPanel" Margin="0,14,0,0">
              <!-- Готовые наборы: домены и программа сервиса одной кнопкой -->
              <TextBlock Text="Готовые наборы" Style="{DynamicResource Caption}" Margin="2,0,0,8"/>
              <StackPanel x:Name="VpnPresets" Margin="0,0,0,8"/>
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="VpnKindSites" Style="{DynamicResource Segment}" GroupName="vpnkind" Content="Сайты" IsChecked="True"/>
                  <RadioButton x:Name="VpnKindApps" Style="{DynamicResource Segment}" GroupName="vpnkind" Content="Программы"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="BtnVpnRoutesImport" Style="{DynamicResource GhostButton}" Height="28" Content="Импорт"
                          ToolTip="Загрузить сайты и программы из файла — например, сохранённого на другом компьютере. Они добавятся к списку"/>
                  <Button x:Name="BtnVpnRoutesExport" Style="{DynamicResource GhostButton}" Height="28" Margin="6,0,0,0" Content="Экспорт"
                          ToolTip="Сохранить сайты и программы, которые идут через VPN, в файл. Ключей и серверов в нём нет — им можно поделиться"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="10" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Background="{DynamicResource Input}" Height="38">
                  <Grid Margin="12,0,3,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VpnListHint" Text="Например: example.com" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                    <TextBox x:Name="VpnListInput" Style="{DynamicResource InputBox}" Margin="-2,0,0,0"/>
                    <Button x:Name="BtnVpnListFile" Grid.Column="1" Style="{DynamicResource IconButton}" Width="30" Height="30" FontSize="14" Content="&#xE8E5;"
                            ToolTip="Добавить списком из файла (.txt) — по строке на сайт или программу"/>
                  </Grid>
                </Border>
                <Button x:Name="BtnVpnListAdd" Grid.Column="1" Style="{DynamicResource AccentButton}" Height="38" Margin="8,0,0,0" Content="Добавить"/>
              </Grid>
              <TextBlock x:Name="VpnListInfo" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,8,0,8" TextWrapping="Wrap" Text=" "/>
              <Border x:Name="VpnListSearchBox" CornerRadius="10" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="34" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid Margin="12,0">
                  <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Icons}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  <TextBlock x:Name="VpnListSearchHint" Text="Поиск по списку" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
                  <TextBox x:Name="VpnListSearch" Style="{DynamicResource InputBox}" Margin="22,0,0,0"/>
                </Grid>
              </Border>
              <StackPanel x:Name="VpnList"/>
            </StackPanel>
          </StackPanel>

          <!-- Вкладка «Соединения» -->
          <StackPanel x:Name="VpnPaneConn" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="VpnConnInfo" Text="Какие сайты и программы сейчас идут через VPN, а какие напрямую. Видно, пока VPN подключён" Style="{DynamicResource RowSub}" Margin="2,0,0,10"/>
            <StackPanel x:Name="VpnConnList"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Настройки -->
      <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SettingsRoot" Margin="22,20,20,14" MaxWidth="860">
          <TextBlock Text="Настройки" Style="{DynamicResource PageTitle}"/>
          <!-- Вкладки настроек -->
          <WrapPanel Margin="0,14,0,0">
            <RadioButton x:Name="SetTabMain" Style="{DynamicResource Segment}" GroupName="settab" Content="Основные" IsChecked="True" Margin="0,0,4,4"/>
            <RadioButton x:Name="SetTabBypass" Style="{DynamicResource Segment}" GroupName="settab" Content="Обход" IsChecked="False" Margin="0,0,4,4"/>
            <RadioButton x:Name="SetTabNet" Style="{DynamicResource Segment}" GroupName="settab" Content="Сеть" IsChecked="False" Margin="0,0,4,4"/>
            <RadioButton x:Name="SetTabLook" Style="{DynamicResource Segment}" GroupName="settab" Content="Вид" IsChecked="False" Margin="0,0,4,4"/>
            <RadioButton x:Name="SetTabLauncher" Style="{DynamicResource Segment}" GroupName="settab" Content="Лаунчер" IsChecked="False" Margin="0,0,4,4"/>
          </WrapPanel>

          <StackPanel Tag="look">
            <StackPanel Orientation="Horizontal" Margin="4,20,0,8">
              <TextBlock Text="&#xE790;" FontFamily="{DynamicResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="ОФОРМЛЕНИЕ" Style="{DynamicResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
            </StackPanel>
          <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{DynamicResource RowIcon}" Text="&#xE790;"/><TextBlock Text="Тема" Style="{DynamicResource RowTitle}"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="ThemeDark" Style="{DynamicResource Segment}" GroupName="theme" Content="Тёмная"/>
                    <RadioButton x:Name="ThemeLight" Style="{DynamicResource Segment}" GroupName="theme" Content="Светлая"/>
                    <RadioButton x:Name="ThemeSystem" Style="{DynamicResource Segment}" GroupName="theme" Content="Как в Windows"/>
                  </StackPanel>
                  <!-- готовые темы: свои фоны и родной акцент; кружок — цвет фона темы с её акцентом -->
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <RadioButton x:Name="ThemeNight" Style="{DynamicResource Segment}" GroupName="theme">
                      <StackPanel Orientation="Horizontal"><Border Width="12" Height="12" CornerRadius="6" Background="#000000" BorderBrush="#7558F7" BorderThickness="2" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Ночь"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ThemeOcean" Style="{DynamicResource Segment}" GroupName="theme">
                      <StackPanel Orientation="Horizontal"><Border Width="12" Height="12" CornerRadius="6" Background="#0A1B25" BorderBrush="#1FB89A" BorderThickness="2" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Океан"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ThemeSunset" Style="{DynamicResource Segment}" GroupName="theme">
                      <StackPanel Orientation="Horizontal"><Border Width="12" Height="12" CornerRadius="6" Background="#1D1019" BorderBrush="#F59E0B" BorderThickness="2" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Закат"/></StackPanel>
                    </RadioButton>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnWallpaperOff" Style="{DynamicResource GhostButton}" Height="32" Content="Убрать" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button x:Name="BtnWallpaper" Style="{DynamicResource GhostButton}" Height="32" Content="Выбрать…"/>
                  </StackPanel>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{DynamicResource RowIcon}" Text="&#xEB9F;"/><TextBlock Text="Картинка на фоне" Style="{DynamicResource RowTitle}"/></StackPanel>
                    <TextBlock x:Name="WallpaperSub" Text="Своё фото или обои за окном — размываются, чтобы текст читался" Style="{DynamicResource RowSub}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{DynamicResource RowIcon}" Text="&#xE771;"/><TextBlock Text="Цвет акцента" Style="{DynamicResource RowTitle}"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="-5,8,0,0">
                    <RadioButton x:Name="AccentTeal" Style="{DynamicResource Swatch}" Background="#1FB89A" ToolTip="Бирюзовый"/>
                    <RadioButton x:Name="AccentBlue" Style="{DynamicResource Swatch}" Background="#3B82F6" ToolTip="Синий"/>
                    <RadioButton x:Name="AccentViolet" Style="{DynamicResource Swatch}" Background="#8B5CF6" ToolTip="Фиолетовый"/>
                    <RadioButton x:Name="AccentGreen" Style="{DynamicResource Swatch}" Background="#22C55E" ToolTip="Зелёный"/>
                    <RadioButton x:Name="AccentOrange" Style="{DynamicResource Swatch}" Background="#F59E0B" ToolTip="Оранжевый"/>
                    <RadioButton x:Name="AccentPink" Style="{DynamicResource Swatch}" Background="#EC4899" ToolTip="Розовый"/>
                    <RadioButton x:Name="AccentSystem" Style="{DynamicResource Swatch}" Background="{DynamicResource SystemAccent}" ToolTip="Как в Windows">
                      <TextBlock Text="&#xE770;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="White"/>
                    </RadioButton>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{DynamicResource RowIcon}" Text="&#xE8A3;"/><TextBlock Text="Масштаб интерфейса" Style="{DynamicResource RowTitle}"/></StackPanel>
                  <TextBlock Text="Крупнее — для больших мониторов, мельче — для небольших экранов" Style="{DynamicResource RowSub}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="Scale90" Style="{DynamicResource Segment}" GroupName="scale" Content="90%"/>
                    <RadioButton x:Name="Scale100" Style="{DynamicResource Segment}" GroupName="scale" Content="100%"/>
                    <RadioButton x:Name="Scale115" Style="{DynamicResource Segment}" GroupName="scale" Content="115%"/>
                    <RadioButton x:Name="Scale130" Style="{DynamicResource Segment}" GroupName="scale" Content="130%"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <CheckBox x:Name="SwMica" Style="{DynamicResource Switch}" Tag="&#xE7F4;">
                <StackPanel>
                  <TextBlock Text="Прозрачный фон (Mica)" Style="{DynamicResource RowTitle}"/>
                  <TextBlock x:Name="MicaSub" Text="Как у приложений Windows 11: сквозь окно слегка видно цвет обоев" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{DynamicResource RowIcon}" Text="&#xE8C1;"/><TextBlock Text="Язык интерфейса" Style="{DynamicResource RowTitle}"/></StackPanel>
                  <TextBlock Text="Лаунчер перезапустится, обход продолжит работать" Style="{DynamicResource RowSub}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="LangRu" Style="{DynamicResource Segment}" GroupName="lang" Content="Русский"/>
                    <RadioButton x:Name="LangEn" Style="{DynamicResource Segment}" GroupName="lang" Content="English"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Button x:Name="BtnOnboarding" Style="{DynamicResource RowButton}" Tag="&#xE897;">
                <StackPanel>
                  <TextBlock Text="Показать приветствие" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Короткое знакомство с лаунчером и VPN" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          </StackPanel>

          <StackPanel Tag="main">
            <StackPanel Orientation="Horizontal" Margin="4,20,0,8">
              <TextBlock Text="&#xE7E8;" FontFamily="{DynamicResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="ЗАПУСК И ОБНОВЛЕНИЯ" Style="{DynamicResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
            </StackPanel>
          <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
              <CheckBox x:Name="SwAutostart" Style="{DynamicResource Switch}" Tag="&#xE7E8;">
                <StackPanel>
                  <TextBlock Text="Запускать вместе с Windows" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Обход включится сам, лаунчер — в трее" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="SwWatchdog" Style="{DynamicResource Switch}" Tag="&#xE9D9;">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Сторож" Style="{DynamicResource RowTitle}"/>
                    <TextBlock x:Name="HelpWatchdog" Style="{DynamicResource HelpIcon}"
                               ToolTip="Каждые несколько минут лаунчер проверяет Discord, YouTube и Telegram. Если winws упал — перезапускает его. Если сайты не открываются несколько проверок подряд (из-за одного сайта — около 8 минут), а интернет есть, — сначала перезапускает стратегию, потом подбирает новую, но не чаще раза в полчаса."/>
                  </StackPanel>
                  <TextBlock Text="Перезапускает упавший обход и сам меняет стратегию, если сайты перестали открываться" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="SwVpnPause" Style="{DynamicResource Switch}" Tag="&#xE769;">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Пауза, пока включён VPN" Style="{DynamicResource RowTitle}"/>
                    <TextBlock x:Name="HelpVpn" Style="{DynamicResource HelpIcon}"
                               ToolTip="VPN сам выводит трафик за пределы блокировок, а zapret вместе с ним только мешает. Когда интернет идёт через VPN-адаптер, обход ставится на паузу и возвращается после отключения VPN."/>
                  </StackPanel>
                  <TextBlock Text="С VPN zapret не нужен: обход выключится сам и вернётся, когда VPN отключат" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>

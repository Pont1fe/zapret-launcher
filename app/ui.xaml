<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret Launcher" Width="1000" Height="700" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" RenderOptions.BitmapScalingMode="HighQuality">

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="76"/>
      <ColumnDefinition Width="5*" MinWidth="400"/>
      <ColumnDefinition Width="6*" MinWidth="440"/>
    </Grid.ColumnDefinitions>

    <!-- Заголовок окна -->
    <Grid Grid.ColumnSpan="3" Background="{DynamicResource TitleBg}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <Image x:Name="TitleIcon" Width="18" Height="18" VerticalAlignment="Center"/>
        <TextBlock Text="Zapret Launcher" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="TitleText" Text="" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnCompact" Style="{DynamicResource ChromeButton}" Content="&#xE73F;" FontSize="12" ToolTip="Компактный вид"/>
        <Button x:Name="BtnMinimize" Style="{DynamicResource ChromeButton}" Content="&#xE921;" ToolTip="Свернуть"/>
        <Button x:Name="BtnMaximize" Style="{DynamicResource ChromeButton}" Content="&#xE922;" ToolTip="Развернуть"/>
        <Button x:Name="BtnClose" Style="{DynamicResource ChromeButton}" Content="&#xE8BB;" ToolTip="Закрыть"/>
      </StackPanel>
    </Grid>

    <!-- Боковое меню -->
    <Grid x:Name="Sidebar" Grid.Row="1" Background="{DynamicResource SidebarBg}">
      <!-- Подсветка выбранного пункта: плавно переезжает к нему -->
      <Border x:Name="NavPill" Width="60" Height="56" CornerRadius="12" Background="{DynamicResource AccentSoft}"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,11,0,0" IsHitTestVisible="False">
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
      </Border>
      <StackPanel x:Name="NavPanel" HorizontalAlignment="Center" Margin="0,8,0,0">
        <RadioButton x:Name="NavStrategies" Style="{DynamicResource NavButton}" Content="&#xE774;" Tag="Обход" IsChecked="True"/>
        <RadioButton x:Name="NavVpn" Style="{DynamicResource NavButton}" Content="&#xE909;" Tag="VPN"/>
        <RadioButton x:Name="NavDomains" Style="{DynamicResource NavButton}" Content="&#xE71B;" Tag="Домены"/>
        <RadioButton x:Name="NavSettings" Style="{DynamicResource NavButton}" Content="&#xE713;" Tag="Настройки"/>
        <RadioButton x:Name="NavLog" Style="{DynamicResource NavButton}" Content="&#xE8A5;" Tag="Журнал"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12">
        <Button x:Name="NavFolder" Style="{DynamicResource IconButton}" Width="44" Height="40" FontSize="16" Content="&#xE8B7;" ToolTip="Папка zapret"/>
        <Button x:Name="NavInfo" Style="{DynamicResource IconButton}" Width="44" Height="40" FontSize="16" Content="&#xE946;" ToolTip="Страница лаунчера на GitHub"/>
      </StackPanel>
    </Grid>

    <!-- Средняя панель -->
    <Grid x:Name="MidPanel" Grid.Row="1" Grid.Column="1" Background="{DynamicResource MidBg}">

      <!-- Стратегии -->
      <Grid x:Name="PageStrategies" Margin="22,20,20,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,6,0">
          <TextBlock Text="Стратегии" Style="{DynamicResource PageTitle}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="BtnInstallUpdate" Style="{DynamicResource IconButton}" Content="&#xE896;" Foreground="{DynamicResource AccentHover}"
                    ToolTip="Установить обновление zapret" Visibility="Collapsed"/>
            <Button x:Name="BtnCheck" Style="{DynamicResource IconButton}" Content="&#xE72C;" ToolTip="Проверить обновления"/>
          </StackPanel>
        </Grid>
        <DockPanel Grid.Row="1" Margin="0,6,0,0" LastChildFill="True">
          <Border DockPanel.Dock="Left" CornerRadius="6" Background="{DynamicResource Card}" Padding="8,2" VerticalAlignment="Center">
            <TextBlock x:Name="VersionPill" Text="" FontSize="11"/>
          </Border>
          <TextBlock x:Name="LatestText" DockPanel.Dock="Left" Text="" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
          <!-- не влезает — многоточие, полный текст в подсказке -->
          <TextBlock x:Name="CardSubtitle" Text="" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,14,6,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border CornerRadius="10" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="38">
            <Grid Margin="12,0">
              <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Icons}" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock x:Name="SearchHint" Text="Поиск стратегии" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
              <TextBox x:Name="SearchBox" Style="{DynamicResource InputBox}" Margin="22,0,0,0"/>
            </Grid>
          </Border>
          <Button x:Name="BtnPing" Grid.Column="1" Style="{DynamicResource GhostButton}" Height="38" Margin="8,0,0,0" ToolTip="Заново проверить сайты и пинг">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock x:Name="PingText" Text="Обновить" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>

        <ListBox x:Name="StrategyList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{DynamicResource StrategyItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
          <ListBox.GroupStyle>
            <GroupStyle>
              <!-- Группа сворачивается кликом по заголовку; начальное состояние — из настроек (GroupOpen первой стратегии группы) -->
              <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                          <ToggleButton x:Name="Head" Style="{DynamicResource GroupHeader}" Tag="{Binding Name}"
                                        IsChecked="{Binding Items[0].GroupOpen, Mode=OneTime}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Name}"/>
                              <TextBlock Text="{Binding ItemCount}" Margin="6,0,0,0" Foreground="{DynamicResource Faint}"/>
                            </StackPanel>
                          </ToggleButton>
                          <ItemsPresenter x:Name="Items"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                          <Trigger SourceName="Head" Property="IsChecked" Value="False">
                            <Setter TargetName="Items" Property="Visibility" Value="Collapsed"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="500" ToolTipService.ShowDuration="20000">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="{Binding Color}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Ellipse Width="6" Height="6" Fill="{Binding MarkColor}" Visibility="{Binding MarkVisibility}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Style="{DynamicResource IconButton}" Width="30" Height="30" FontSize="14"
                        Content="{Binding StarGlyph}" Foreground="{Binding StarColor}" Tag="{Binding File}" ToolTip="{Binding StarTip}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Домены -->
      <Grid x:Name="PageDomains" Visibility="Collapsed" Margin="22,20,20,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Домены" Style="{DynamicResource PageTitle}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
          <RadioButton x:Name="DomGeneral" Style="{DynamicResource Segment}" GroupName="dom" Content="Обходить" IsChecked="True"/>
          <RadioButton x:Name="DomExclude" Style="{DynamicResource Segment}" GroupName="dom" Content="Не трогать"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border CornerRadius="10" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Background="{DynamicResource Input}" Height="38">
            <Grid Margin="12,0,3,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="DomainHint" Text="Например: site.ru" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
              <TextBox x:Name="DomainInput" Style="{DynamicResource InputBox}" Margin="-2,0,0,0"/>
              <Button x:Name="BtnDomainFile" Grid.Column="1" Style="{DynamicResource IconButton}" Width="30" Height="30" FontSize="14" Content="&#xE8E5;"
                      ToolTip="Добавить списком из файла (.txt) — по домену на строку"/>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BtnCheckDomain" Style="{DynamicResource GhostButton}" Height="38" Margin="8,0,0,0" Content="Проверить"
                    ToolTip="Проверить, открывается ли сайт сейчас"/>
            <Button x:Name="BtnAddDomain" Style="{DynamicResource AccentButton}" Height="38" Margin="8,0,0,0" Content="Добавить"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="DomainInfo" Grid.Row="3" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,8,0,12" TextWrapping="Wrap"
                   Text="Можно сразу несколько — через пробел, запятую или вставить списком. Поддомены учитываются автоматически."/>
        <!-- Готовые наборы: все домены сервиса одной кнопкой -->
        <StackPanel x:Name="DomainPresetBox" Grid.Row="4" Margin="0,0,0,10">
          <TextBlock Text="Готовые наборы" Style="{DynamicResource Caption}" Margin="2,0,0,8"/>
          <StackPanel x:Name="DomainPresets"/>
        </StackPanel>
        <Grid Grid.Row="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <!-- Поиск — когда доменов много -->
          <Border x:Name="DomainSearchBox" CornerRadius="10" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="34" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid Margin="12,0">
              <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Icons}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock x:Name="DomainSearchHint" Text="Поиск по списку" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
              <TextBox x:Name="DomainSearch" Style="{DynamicResource InputBox}" Margin="22,0,0,0"/>
            </Grid>
          </Border>
          <StackPanel x:Name="DomainEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource Icons}" FontSize="34" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DomainEmptyText" Text="Список пуст" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Margin="0,12,0,0"/>
          </StackPanel>
          <!-- включённые наборы — карточкой, остальные домены — по строке -->
          <ScrollViewer x:Name="DomainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DomainItems" Margin="0,0,6,0"/>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- VPN -->
      <ScrollViewer x:Name="PageVpn" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,20,14">
          <TextBlock Text="VPN" Style="{DynamicResource PageTitle}"/>
          <TextBlock Text="Через ваш сервер или подписку. Выбранные сайты и программы идут через VPN, остальное — напрямую и через обход" Style="{DynamicResource RowSub}" Margin="0,6,0,0"/>

          <!-- Карточка подключения: флаг страны, состояние, время, скорость; клик — включить или выключить -->
          <Grid x:Name="VpnCard" Margin="0,16,0,0" MinHeight="118" Cursor="Hand" Background="Transparent">
            <Border CornerRadius="20" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
            <Border x:Name="VpnCardOn" CornerRadius="20" BorderBrush="{DynamicResource ActiveBorder}" BorderThickness="1" Opacity="0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{DynamicResource ActiveFromColor}" Offset="0"/>
                  <GradientStop Color="{DynamicResource ActiveToColor}" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <!-- вспышка после подключения и бегущая по краю полоска, пока VPN подключается -->
            <Border x:Name="VpnFlash" CornerRadius="20" Background="{DynamicResource Accent}" Opacity="0" IsHitTestVisible="False"/>
            <Rectangle x:Name="VpnBusyLine" RadiusX="20" RadiusY="20" StrokeThickness="2" Stroke="{DynamicResource Accent}" StrokeDashArray="24 96"
                       StrokeDashCap="Round" Opacity="0" IsHitTestVisible="False"/>
            <Grid Margin="20,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="VpnFlagHost" Width="54" Height="38" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="VpnDot" Width="9" Height="9" Fill="{DynamicResource Idle}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                  <TextBlock x:Name="VpnStatus" Text="VPN выключен" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="VpnSub" Text=" " FontSize="12" Foreground="{DynamicResource TextSub}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="VpnTimer" Text=" " FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="VpnTraffic" Text=" " FontSize="11" Foreground="{DynamicResource TextSub}" Margin="0,2,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
              </StackPanel>
              <Grid Grid.Column="2" Width="60" Height="32" VerticalAlignment="Center">
                <Border CornerRadius="16" Background="{DynamicResource TrackOff}"/>
                <Border x:Name="VpnTrackOn" CornerRadius="16" Background="{DynamicResource Accent}" Opacity="0"/>
                <Ellipse x:Name="VpnKnob" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="4,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform X="0"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
            </Grid>
          </Grid>
          <!-- скорость загрузки через VPN за последние минуты -->
          <Canvas x:Name="VpnGraph" Height="38" Margin="6,8,6,0" Visibility="Collapsed" ClipToBounds="True"/>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <RadioButton x:Name="VpnTabServers" Style="{DynamicResource Segment}" GroupName="vpntab" Content="Серверы" IsChecked="True"/>
            <RadioButton x:Name="VpnTabRoutes" Style="{DynamicResource Segment}" GroupName="vpntab" Content="Маршруты"/>
            <RadioButton x:Name="VpnTabConn" Style="{DynamicResource Segment}" GroupName="vpntab" Content="Соединения"/>
          </StackPanel>

          <!-- Вкладка «Серверы» -->
          <StackPanel x:Name="VpnPaneServers" Margin="0,14,0,0">
            <!-- Подсказка при первом открытии -->
            <Border x:Name="VpnHelp" CornerRadius="14" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                    Padding="16,13" Margin="0,0,0,12" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <TextBlock Text="Как начать" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button x:Name="BtnVpnHelpOk" Style="{DynamicResource GhostButton}" Height="28" HorizontalAlignment="Right" Content="Понятно"/>
                </Grid>
                <TextBlock Text="1.  Вставьте ключ или адрес подписки ниже — или откройте QR-код" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="2.  Во вкладке «Маршруты» выберите, что пускать через VPN" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="3.  Нажмите на карточку VPN выше — и готово" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <!-- В буфере обмена лежит ключ — предлагаем добавить -->
            <Border x:Name="VpnClipBar" CornerRadius="10" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                    Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VpnClipText" Text="В буфере обмена есть ключ VPN" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="BtnVpnClipAdd" Grid.Column="1" Style="{DynamicResource AccentButton}" Height="30" Margin="10,0,0,0" Content="Добавить"/>
              </Grid>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border CornerRadius="10" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Background="{DynamicResource Input}" Height="38">
                <Grid Margin="12,0">
                  <TextBlock x:Name="VpnHint" Text="Ключ vless://, vmess://, trojan://, ss://… или адрес подписки" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                  <TextBox x:Name="VpnInput" Style="{DynamicResource InputBox}" Margin="-2,0,0,0"/>
                </Grid>
              </Border>
              <Button x:Name="BtnVpnAdd" Grid.Column="1" Style="{DynamicResource AccentButton}" Height="38" Margin="8,0,0,0" Content="Добавить"/>
            </Grid>
            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="BtnVpnQrFile" Style="{DynamicResource GhostButton}" Height="30" Margin="0,0,8,0" Content="QR из картинки…" ToolTip="Открыть картинку или скриншот с QR-кодом ключа"/>
              <Button x:Name="BtnVpnQrScreen" Style="{DynamicResource GhostButton}" Height="30" Content="Найти QR на экране" ToolTip="Откройте QR-код ключа в любом окне и нажмите — лаунчер найдёт его на экране"/>
            </WrapPanel>
            <TextBlock x:Name="VpnInfo" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,8,0,10" TextWrapping="Wrap"
                       Text="Ключи хранятся только на этом компьютере, в настройках лаунчера"/>
            <!-- Подписка: сколько трафика осталось и до какого числа -->
            <Border x:Name="VpnSubCard" CornerRadius="10" Background="{DynamicResource Card}" Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <TextBlock x:Name="VpnSubText" Text=" " FontSize="12"/>
                  <TextBlock x:Name="VpnSubExpire" Text=" " FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                </Grid>
                <Border x:Name="VpnSubBarBg" CornerRadius="3" Background="{DynamicResource IconBg}" Height="6" Margin="0,7,0,0">
                  <Border x:Name="VpnSubBar" CornerRadius="3" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="0"/>
                </Border>
              </StackPanel>
            </Border>
            <!-- Поиск — когда серверов много -->
            <Border x:Name="VpnSearchBox" CornerRadius="10" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="34" Margin="0,0,0,10" Visibility="Collapsed">
              <Grid Margin="12,0">
                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Icons}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock x:Name="VpnSearchHint" Text="Поиск сервера или страны" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
                <TextBox x:Name="VpnSearch" Style="{DynamicResource InputBox}" Margin="22,0,0,0"/>
              </Grid>
            </Border>
            <WrapPanel x:Name="VpnTabs" Margin="0,0,0,4" Visibility="Collapsed"/>
            <StackPanel x:Name="VpnServerList"/>
            <WrapPanel Margin="0,4,0,0">
              <Button x:Name="BtnVpnPing" Style="{DynamicResource GhostButton}" Height="32" Margin="0,0,8,6" Content="Проверить серверы" ToolTip="Открыть тестовую страницу через каждый сервер и замерить время"/>
              <Button x:Name="BtnVpnBest" Style="{DynamicResource GhostButton}" Height="32" Margin="0,0,8,6" Content="Выбрать самый быстрый"/>
              <Button x:Name="BtnVpnRefresh" Style="{DynamicResource GhostButton}" Height="32" Margin="0,0,8,6" Content="Обновить подписку" Visibility="Collapsed"/>
            </WrapPanel>
            <Border Style="{DynamicResource SettingsCard}" Margin="0,6,0,0">
              <CheckBox x:Name="SwVpnAuto" Style="{DynamicResource Switch}" BorderThickness="0" Tag="&#xE8B1;">
                <StackPanel>
                  <TextBlock Text="Автовыбор сервера" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="При подключении — самый быстрый сервер; если он перестал отвечать, VPN сам перейдёт на другой" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </CheckBox>
            </Border>
          </StackPanel>

          <!-- Вкладка «Маршруты» -->
          <StackPanel x:Name="VpnPaneRoutes" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="VpnModeSplit" Style="{DynamicResource Segment}" GroupName="vpnmode" Content="Только выбранное"/>
              <RadioButton x:Name="VpnModeRu" Style="{DynamicResource Segment}" GroupName="vpnmode" Content="Россия напрямую"/>
              <RadioButton x:Name="VpnModeAll" Style="{DynamicResource Segment}" GroupName="vpnmode" Content="Весь трафик"/>
            </StackPanel>
            <TextBlock x:Name="VpnModeText" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,8,0,0" TextWrapping="Wrap" Text=" "/>
            <!-- Сайты, которые провайдер режет по адресу: одной кнопкой — через VPN -->

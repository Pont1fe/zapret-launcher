                <StackPanel>
                  <TextBlock x:Name="LauncherRollbackTitle" Text="Вернуть прошлую версию лаунчера" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Если новая версия работает хуже. Настройки перед откатом сохранятся в резервную копию" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnBackupSave" Style="{DynamicResource RowButton}" Tag="&#xE74E;">
                <StackPanel>
                  <TextBlock Text="Сохранить настройки в файл" Style="{DynamicResource RowTitle}"/>
                  <TextBlock Text="Настройки, домены, избранное и профили сетей — для переустановки Windows или другого компьютера" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnBackupRestore" Style="{DynamicResource RowButton}" Tag="&#xE777;">
                <StackPanel>
                  <TextBlock Text="Восстановить настройки из файла" Style="{DynamicResource RowTitle}"/>
                  <TextBlock x:Name="BackupSub" Text="Лаунчер перезапустится, обход продолжит работать" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnUninstall" Style="{DynamicResource RowButton}" Tag="&#xE74D;">
                <StackPanel>
                  <TextBlock Text="Удалить всё" Style="{DynamicResource RowTitle}" Foreground="{DynamicResource Danger}"/>
                  <TextBlock Text="Остановить обход, убрать автозапуск, драйвер, записи в hosts и ярлыки" Style="{DynamicResource RowSub}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Журнал -->
      <Grid x:Name="PageLog" Visibility="Collapsed" Margin="22,20,20,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <Grid>
            <TextBlock Text="Журнал" Style="{DynamicResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="BtnLogCopy" Style="{DynamicResource GhostButton}" Height="30" Content="Копировать" ToolTip="Скопировать показанные строки — например, чтобы отправить разработчику"/>
              <Button x:Name="BtnLogOpen" Style="{DynamicResource GhostButton}" Height="30" Margin="6,0,0,0" Content="Открыть файл" ToolTip="Открыть весь журнал в Блокноте"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="10" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Height="32">
              <Grid Margin="12,0">
                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Icons}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock x:Name="LogSearchHint" Text="Поиск в журнале" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
                <TextBox x:Name="LogSearch" Style="{DynamicResource InputBox}" Margin="22,0,0,0"/>
              </Grid>
            </Border>
            <ToggleButton x:Name="LogImportant" Grid.Column="1" Style="{DynamicResource Chip}" Margin="8,0,0,0" Content="Только важное"
                          ToolTip="Показать только ошибки и предупреждения"/>
          </Grid>
        </StackPanel>
        <!-- строки журнала: время отдельно, ошибки красным, предупреждения жёлтым -->
        <Border Grid.Row="1" CornerRadius="14" Background="{DynamicResource Card}" Padding="12,10,4,10">
          <Grid>
            <TextBlock x:Name="LogEmpty" Text="Ничего не найдено" FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,0,0,0" Visibility="Collapsed"/>
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="0,1,8,1"/>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86"/>
                      <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Faint}" Margin="0,1,0,0"/>
                    <TextBlock x:Name="msg" Grid.Column="1" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSub}"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="err">
                      <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource Danger}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="trace">
                      <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource Danger}"/>
                      <Setter TargetName="msg" Property="FontFamily" Value="Consolas"/>
                      <Setter TargetName="msg" Property="FontSize" Value="11"/>
                      <Setter TargetName="msg" Property="Opacity" Value="0.75"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="warn">
                      <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource WarnText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="ok">
                      <Setter TargetName="msg" Property="Foreground" Value="{DynamicResource AccentHover}"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Правая панель: статус -->
    <Grid Grid.Row="1" Grid.Column="2" ClipToBounds="True" Background="{DynamicResource RightBg}">
      <Ellipse x:Name="GlowBg" Width="560" Height="420" VerticalAlignment="Top" Margin="0,-170,0,0" Opacity="0" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="{DynamicResource GlowColor}" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- Сверху — прокручиваемое содержимое (на маленьком окне ничего не уходит за край), снизу — кнопки-переключатели всегда на виду -->
      <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
        <StackPanel>
        <Grid DockPanel.Dock="Top">
          <TextBlock Text="СТАТУС ОБХОДА" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
          <Border HorizontalAlignment="Right" CornerRadius="12" Background="{DynamicResource Card}" Padding="10,4" MaxWidth="300">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="NetIcon" Text="&#xE839;" FontFamily="{DynamicResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock x:Name="NetStatus" Text=" " FontSize="11" Foreground="{DynamicResource TextSub}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Предупреждение — одной тонкой строкой; полный текст во всплывающей подсказке -->
        <Border x:Name="ConflictBar" DockPanel.Dock="Top" Margin="0,12,0,0" CornerRadius="9" Background="{DynamicResource WarnBg}"
                BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1" Padding="10,5" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{DynamicResource Icons}" FontSize="12" Foreground="{DynamicResource WarnText}" Margin="0,1,8,0" VerticalAlignment="Center"/>
            <Button x:Name="BtnFixConflict" DockPanel.Dock="Right" Content="Исправить" Cursor="Hand" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="b" CornerRadius="6" Padding="9,2" Background="Transparent" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1"
                          TextElement.Foreground="{DynamicResource WarnText}" TextElement.FontSize="11" TextElement.FontWeight="SemiBold">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Background" Value="{DynamicResource WarnBorder}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <TextBlock x:Name="ConflictText" Foreground="{DynamicResource WarnText}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>

        <!-- Сторож сменил стратегию — можно вернуть прежнюю -->
        <Border x:Name="StrategyChangedBar" DockPanel.Dock="Top" Margin="0,12,0,0" CornerRadius="9" Background="{DynamicResource AccentSoft}"
                BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Padding="10,4,4,4" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE8AB;" FontFamily="{DynamicResource Icons}" FontSize="12" Foreground="{DynamicResource AccentHover}" Margin="0,1,8,0" VerticalAlignment="Center"/>
            <Button x:Name="BtnStrategyChangedClose" DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Width="24" Height="24" FontSize="9" Content="&#xE711;" ToolTip="Скрыть"/>
            <Button x:Name="BtnRevertStrategy" DockPanel.Dock="Right" Style="{DynamicResource GhostButton}" Height="24" Margin="8,0,4,0" Content="Вернуть прежнюю"/>
            <TextBlock x:Name="StrategyChangedText" Foreground="{DynamicResource Text}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>

        <!-- Большая карточка-переключатель: подсветка — отдельный слой, его прозрачность анимируется -->
        <Grid x:Name="PowerButton" DockPanel.Dock="Top" Margin="0,16,0,0" Height="148" Cursor="Hand" Background="Transparent">
          <Border x:Name="PowerBase" CornerRadius="22" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
          <Border x:Name="ActiveLayer" CornerRadius="22" BorderBrush="{DynamicResource ActiveBorder}" BorderThickness="1" Opacity="0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource ActiveFromColor}" Offset="0"/>
                <GradientStop Color="{DynamicResource ActiveToColor}" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
              <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>
          </Border>
          <!-- Жёлтый — пауза из-за VPN, красный — ошибка: цвет задаётся в коде -->
          <Border x:Name="StateLayer" CornerRadius="22" BorderThickness="1" Opacity="0"/>
          <!-- Волна при включении: расходится от значка щита -->
          <Canvas IsHitTestVisible="False" ClipToBounds="True" x:Name="RippleHost">
            <Ellipse x:Name="Ripple" Width="64" Height="64" Fill="{DynamicResource Accent}" Opacity="0" Canvas.Left="22" Canvas.Top="42"
                     RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
              </Ellipse.RenderTransform>
            </Ellipse>
          </Canvas>
          <Grid Margin="22,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="64" Height="64" VerticalAlignment="Center">
              <Border CornerRadius="20" Background="{DynamicResource IconBg}"/>
              <Border x:Name="PowerIconOn" CornerRadius="20" Background="{DynamicResource Accent}" Opacity="0"/>
              <TextBlock x:Name="PowerIcon" Text="&#xEA18;" FontFamily="{DynamicResource Icons}" FontSize="28" Foreground="{DynamicResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <!-- Индикатор загрузки: полоска бежит по контуру скруглённой иконки, пока обход включается, выключается или идёт подбор.
                   Периметр контура (74×74, радиус 24) ≈ 255 px = 85 толщин линии — сумма штриха и пробела ровно один круг -->
              <Rectangle x:Name="BusyRing" Margin="-5" RadiusX="24" RadiusY="24" StrokeThickness="3" Stroke="{DynamicResource Accent}"
                         StrokeDashArray="22 63" StrokeDashCap="Round" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
              <TextBlock x:Name="PowerStatus" Text="Обход выключен" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="PowerTimer" Text=" " FontSize="12" Foreground="{DynamicResource TextSub}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="PowerHint" Text="Нажмите, чтобы включить" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
              <!-- Встроенный VPN: показывается, пока он включён -->
              <StackPanel x:Name="PowerVpn" Orientation="Horizontal" Margin="0,7,0,0" Visibility="Collapsed">
                <Border CornerRadius="6" Background="{DynamicResource AccentSoft}" Padding="7,2">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="PowerVpnDot" Width="6" Height="6" Fill="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PowerVpnText" Text="VPN" FontSize="11" Foreground="{DynamicResource AccentHover}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
            <Grid Grid.Column="2" Width="60" Height="32" VerticalAlignment="Center">
              <Border CornerRadius="16" Background="{DynamicResource TrackOff}"/>
              <Border x:Name="ToggleTrackOn" CornerRadius="16" Background="{DynamicResource Accent}" Opacity="0"/>
              <Ellipse x:Name="ToggleKnob" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="4,0">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
          </Grid>
          <!-- Прогресс подбора стратегии -->
          <Grid x:Name="PickProgress" VerticalAlignment="Bottom" Height="4" Margin="22,0,22,14" Visibility="Collapsed" IsHitTestVisible="False">
            <Border CornerRadius="2" Background="{DynamicResource TrackOff}"/>
            <Border x:Name="PickFill" CornerRadius="2" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="0"/>
              </Border.RenderTransform>
            </Border>
          </Grid>
        </Grid>

        <!-- Текущая стратегия -->
        <Border DockPanel.Dock="Top" Margin="0,12,0,0" CornerRadius="16" Background="{DynamicResource CardRaised}" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="CurrentBadgeBg" Width="38" Height="38" CornerRadius="11" Background="#3B82F6" VerticalAlignment="Center">
              <TextBlock x:Name="CurrentBadge" Text="G" FontSize="12" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <TextBlock Text="Стратегия" FontSize="11" Foreground="{DynamicResource Muted}"/>
              <TextBlock x:Name="CurrentName" Text="" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="BtnQuickPick" Style="{DynamicResource GhostButton}" Width="40" Height="34" Margin="0,0,6,0"
                      ToolTip="Быстрый подбор по избранному: проверить только стратегии со звёздочкой">
                <TextBlock Text="&#xE734;" FontFamily="{DynamicResource Icons}" FontSize="14"/>
              </Button>
              <Button x:Name="BtnMain" Style="{DynamicResource GhostButton}" Height="34" Content="Подобрать стратегию"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Доступность сайтов -->
        <Grid DockPanel.Dock="Top" Margin="2,14,0,8">
          <TextBlock Text="ДОСТУПНОСТЬ САЙТОВ" Style="{DynamicResource Caption}" VerticalAlignment="Center" Background="Transparent"
                     ToolTip="Крупно — время открытия сайта через обход, TCP — пинг до сервера. Линия — последние проверки"/>
          <Button x:Name="BtnSiteCheck" Style="{DynamicResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE72C;"
                  HorizontalAlignment="Right" ToolTip="Проверить сейчас"/>
        </Grid>
        <UniformGrid x:Name="SitePanel" DockPanel.Dock="Top" Rows="1"/>
        <!-- История за сутки: когда обход работал, стоял на паузе или не работал -->
        <Grid DockPanel.Dock="Top" Margin="2,6,0,8">
          <TextBlock Text="ЗА СУТКИ" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
          <TextBlock x:Name="HistorySummary" Text="" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <!-- компактно: полоса за 24 часа (слева — сутки назад, справа — сейчас) и легенда -->
        <Border DockPanel.Dock="Top" CornerRadius="14" Background="{DynamicResource CardRaised}" Padding="12,10" ToolTip="Слева — сутки назад, справа — сейчас. Наведите на отрезок, чтобы увидеть время">
          <StackPanel>
            <Border CornerRadius="4" Background="{DynamicResource IconBg}" Height="10" ClipToBounds="True">
              <Canvas x:Name="HistoryBar"/>
            </Border>
            <WrapPanel x:Name="HistoryLegend" Margin="0,7,0,0"/>
          </StackPanel>
        </Border>

        </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="1" Margin="0,10,0,0">
          <ToggleButton x:Name="ChipAutostart" Style="{DynamicResource Chip}" Content="Автозапуск"/>
          <ToggleButton x:Name="ChipAutoUpdate" Style="{DynamicResource Chip}" Content="Автообновление"/>
          <ToggleButton x:Name="ChipTelegram" Style="{DynamicResource Chip}" Content="Telegram"/>
          <ToggleButton x:Name="ChipVpn" Style="{DynamicResource Chip}" Content="VPN" ToolTip="Встроенный VPN: сайты и программы из списка на странице VPN"/>
        </WrapPanel>
      </Grid>
    </Grid>

    <!-- Экран первого запуска -->
    <Grid x:Name="Onboarding" Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource Overlay}" Visibility="Collapsed">
      <Border x:Name="OnbCard" Width="520" CornerRadius="22" Background="{DynamicResource CardRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              Padding="34,30" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
          <Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
            <TextBlock x:Name="OnbIcon" Text="&#xEA18;" FontFamily="{DynamicResource Icons}" FontSize="32" Foreground="{DynamicResource AccentHover}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="OnbTitle" Text="" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="OnbText" Text="" FontSize="13" Foreground="{DynamicResource TextSub}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"/>
          <!-- Картинка шага: рисуется кодом из элементов интерфейса, поэтому сама подстраивается под тему -->
          <Border x:Name="OnbPicture" Margin="0,18,0,0" Visibility="Collapsed"/>
          <Grid Margin="0,26,0,0">
            <StackPanel x:Name="OnbDots" Orientation="Horizontal" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="OnbSkip" Style="{DynamicResource GhostButton}" Height="36" MinWidth="110" Content="Пропустить"/>
              <Button x:Name="OnbNext" Style="{DynamicResource AccentButton}" Height="36" MinWidth="130" Margin="8,0,0,0" Content="Дальше"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
